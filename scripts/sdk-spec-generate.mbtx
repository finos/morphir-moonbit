// Regenerates pkgs/morphir-sdk-spec/sdk_data.mbt from pkgs/morphir-sdk-spec/sdk.scm.
// It runs the native `sdkgen generate` tool of pkgs/morphir-typing-tools.

///|
import {
  "moonbitlang/async@0.22.1",
  "moonbitlang/async@0.22.1/process",
  "moonbitlang/async@0.22.1/stdio",
  "moonbitlang/x@0.5.5/sys",
}

///|
async fn main {
  let code = @process.run(
    "moon",
    ["run", "pkgs/morphir-typing-tools/sdkgen", "--target", "native", "--", "generate"],
    stdout=@stdio.stdout,
    stderr=@stdio.stderr,
  )
  if code != 0 {
    @sys.exit(if code > 0 { code } else { 1 })
  }
}
