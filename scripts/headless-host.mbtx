///|
/// Build the pinned actual authenticated host and installed artifact producer.
/// Cargo owns compilation; its structured artifact messages identify the fixture.
import {
  "moonbitlang/async@0.22.1",
  "moonbitlang/async@0.22.1/fs",
  "moonbitlang/async@0.22.1/process",
  "moonbitlang/async@0.22.1/stdio",
  "moonbitlang/core/env",
  "moonbitlang/core/json",
}

///|
let revision = "b0de0899b2a9d37a33730d65505f0b3d39274132"

///|
fn executable(messages : String) -> String? {
  let matches : Array[String] = []
  for line in messages.split("\n") {
    let value = @json.parse(line.to_owned()) catch { _ => continue }
    if value
      is {
        "reason": String("compiler-artifact"),
        "target": { "name": String("ui_artifact_process"), .. },
        "executable": String(path),
        ..
      } {
      matches.push(path)
    }
  }
  if matches.length() == 1 {
    Some(matches[0])
  } else {
    None
  }
}

///|
async fn output(program : String, args : Array[String], cwd : String) -> String {
  let (code, stdout, stderr) = @process.collect_output(program, args, cwd~)
  guard code == 0 else { fail(program + ": " + stderr.text() + stdout.text()) }
  stdout.text().trim().to_owned()
}

///|
async fn main {
  let args = @env.args()[1:].to_owned()
  if args == ["--self-test"] {
    let fixture = "{\"reason\":\"compiler-artifact\",\"target\":{\"name\":\"ui_artifact_process\"},\"executable\":\"/tmp/fixture\"}"
    guard executable("not-json\n" + fixture) == Some("/tmp/fixture") &&
      executable(fixture + "\n" + fixture) == None &&
      executable("{\"reason\":\"build-finished\"}") == None else {
      fail("Cargo artifact selection must be exact and unambiguous")
    }
    @stdio.stdout.write(
      "headless-host: exact Cargo artifact selection passed\n",
    )
    return
  }
  guard args is [source] else {
    fail("Usage: headless-host.mbtx UPSTREAM_CHECKOUT | --self-test")
  }
  let source = @fs.realpath(source)
  guard output("git", ["rev-parse", "HEAD"], source) == revision &&
    output("git", ["status", "--porcelain", "--untracked-files=no"], source) ==
    "" else {
    fail("Clean exact upstream host revision required")
  }
  ignore(output("cargo", ["build", "--locked", "-p", "morphir"], source))
  let messages = output(
    "cargo",
    [
      "test", "--locked", "-p", "morphir", "--test", "ui_artifact_process", "--no-run",
      "--message-format=json",
    ],
    source,
  )
  guard executable(messages) is Some(fixture) &&
    fixture.has_prefix(source + "/target/") else {
    fail("One Cargo-built installed artifact fixture is required")
  }
  let host = source + "/target/debug/morphir"
  for path in [host, fixture] {
    guard @fs.kind(path, follow_symlink=false) is Regular &&
      !path.contains("\n") &&
      !path.contains("\r") else {
      fail("Regular host executable with a single-line path required")
    }
  }
  let values = "MORPHIR_WORKBENCH_LIVE_HOST=" +
    host +
    "\nMORPHIR_MCK_BIN=" +
    host +
    "\nMORPHIR_WORKBENCH_ARTIFACT_HOST=" +
    fixture +
    "\n"
  @stdio.stdout.write(values)
  if @env.get_env_var("GITHUB_ENV") is Some(path) {
    @fs.write_file(path, @fs.read_file(path).text() + values)
  }
}
