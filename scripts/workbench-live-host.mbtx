///|
/// Opt-in browser acceptance against a real Rust morphir ui binary. The
/// Playwright test owns temporary workspace/home fixtures and host cleanup.
/// Run: moonx scripts/workbench-live-host.mbtx --host-bin /path/to/morphir
import {
  "moonbitlang/core/argparse",
  "moonbitlang/async@0.22.1",
  "moonbitlang/async@0.22.1/process",
  "moonbitlang/x@0.5.5/sys",
}

///|
async fn main {
  let command = @argparse.Command(
    "workbench-live-host",
    about="Test the Workbench browser against an existing Rust Morphir UI binary",
    options=[@argparse.OptionArg("host-bin", required=true)],
  )
  let matches = command.parse()
  guard matches.values.get("host-bin") is Some([binary]) else { @sys.exit(2) }
  let status = @process.run(
    "node",
    ["apps/morphir-workbench/scripts/browser-test.js"],
    extra_env={ "MORPHIR_WORKBENCH_LIVE_HOST_BIN": binary },
  )
  @sys.exit(if status < 0 { 1 } else { status })
}
