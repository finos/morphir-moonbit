----
import {
  "moonbitlang/core/argparse",
  "moonbitlang/async@0.22.7",
  "moonbitlang/async@0.22.7/fs",
  "moonbitlang/async@0.22.7/process",
  "moonbitlang/async@0.22.7/stdio",
  "moonbitlang/core/json",
  "moonbitlang/core/env",
  "moonbitlang/x@0.5.5/sys",
}
----

// Acquire the audited LLVM compiler/core in a new isolated directory.

///|
// Selected only at the owned CLI boundary, never from a child or a path value.
let json_mode : Ref[Bool] = Ref(false)

///|
fn succeeded(result : Json) -> Json {
  {
    "profile": "morphir/command-result",
    "contractVersion": "0.1.0",
    "command": "llvm.setup",
    "state": "succeeded",
    "exitCode": 0,
    "result": result,
    "diagnostics": [],
  }
}

///|
priv suberror CommandAbort {
  Message(String)
}

///|
fn[T] refuse(message : String) -> T raise {
  if json_mode.val {
    raise CommandAbort::Message(message)
  } else {
    abort(message)
  }
}

///|
async fn failed(error : Error) -> Unit {
  // New opt-in JSON refusals use explicit exit 1 on every host. Legacy
  // default invocations still retain their original abort/signal behavior.
  let message = match error {
    CommandAbort::Message(message) => message
    _ => error.to_string()
  }
  @stdio.stderr.write(message + "\n")
  let value : Json = {
    "profile": "morphir/command-result",
    "contractVersion": "0.1.0",
    "command": "llvm.setup",
    "state": "failed",
    "exitCode": 1,
    "error": { "code": "command_failed", "message": message },
    "diagnostics": [],
  }
  @stdio.stdout.write(value.stringify() + "\n")
  @sys.exit(1)
}

///|
async fn output(
  program : String,
  args : Array[String],
  cwd~ : String = ".",
) -> String {
  let (code, out, err) = @process.collect_output(program, args, cwd~)
  if code != 0 {
    @stdio.stderr.write(err)
    if json_mode.val {
      fail(program + ": " + err.text())
    }
    @sys.exit(1)
  }
  out.text().trim().to_owned()
}

///|
fn text(json : Json, key : String) -> String raise {
  guard json is Object(fields) && fields.get(key) is Some(String(value)) else {
    refuse("Missing identity field: " + key)
  }
  value
}

///|
/// moonbitlang/moon#2420 is still open: moon compiles `native` source files for
/// LLVM but keeps `#cfg(target="native")` imports from it, so an unpatched
/// `moon bundle --target llvm` fails on core/async. Until a nightly ships that
/// fix, give the hash-checked core the same rule. Each atom expands in place, so
/// it holds inside any boolean condition, and only `#cfg` lines change.
/// Bead morphir-ukvn.5.64.36.25 removes this step when upstream ships.
fn llvm_conditional_imports(manifest : String) -> String {
  manifest
  .split("\n")
  .map(line => {
    let line = line.to_owned()
    if line.has_prefix("#cfg(") {
      line.replace_all(
        old="target=\"native\"",
        new="any(target=\"native\", target=\"llvm\")",
      )
    } else {
      line
    }
  })
  .collect()
  .join("\n")
}

///|
async fn patch_core_imports(directory : String) -> Unit {
  for entry in @fs.readdir(directory) {
    let path = directory + "/" + entry
    match @fs.kind(path) {
      Directory => patch_core_imports(path)
      Regular if entry == "moon.pkg" => {
        let manifest = @fs.read_file(path).text()
        let patched = llvm_conditional_imports(manifest)
        if patched != manifest {
          @fs.write_file(path, patched)
        }
      }
      _ => ()
    }
  }
}

///|
async fn core_source_identity(repo : String, core : String) -> String {
  output("node", [
    "--input-type=module",
    "-e",
    (
      #|import {pathToFileURL} from 'node:url';import {join} from 'node:path';
      #|const [repo,core]=process.argv.slice(1);
      #|const {treeIdentity}=await import(pathToFileURL(join(repo,'apps/morphir/build-provider/identity.mjs')));
      #|console.log(treeIdentity(core,{core:true,includeBuild:false}));
    ),
    repo,
    core,
  ])
}

///|
async fn execute() -> Json {
  // These development gates consume portable provider modules on a fresh checkout.
  let (runtime_status, _, runtime_error) = @process.collect_output("bun", [
    "run", "build:runtimes",
  ])
  guard runtime_status == 0 else {
    fail("Runtime JavaScript build failed: " + runtime_error.text())
  }

  guard output("node", ["-p", "process.platform+'-'+process.arch"]) ==
    "darwin-arm64" else {
    refuse("Required LLVM acceptance supports darwin/arm64")
  }
  let directory = @env.get_env_var("MORPHIR_LLVM_HOME").unwrap_or(
    ".dev/llvm-toolchain",
  )
  guard !@fs.exists(directory) else {
    refuse("Acquire LLVM into a new isolated directory")
  }
  @fs.mkdir(directory, recursive=true)
  let home = @fs.realpath(directory)
  let version = "0.10.18+37579be88-nightly"
  let compiler_url = "https://cli.moonbitlang.com/binaries/0.10.18%2B37579be88-nightly/moonbit-darwin-aarch64.tar.gz"
  let core_url = "https://cli.moonbitlang.com/cores/core-0.10.18%2B37579be88-nightly.tar.gz"
  let compiler_hash = "613fedf8ea82a2aabc4cff08dfb8c75e093eeb37231842e5ed45a2396aed95eb"
  let core_hash = "739e322a6514594e675b76ec72660567ac0f2f87f1480bc8e0fe8d4c23b80f23"
  // The core source after patch_core_imports, so the changed tree stays verified.
  let patched_core_identity = "44bfcd9a03ec1e038ad351d88382b9051b22d00c5f496cbdb9161674a94764d2"
  let scratch = @fs.tmpdir(prefix="morphir-llvm-")
  defer @fs.rmdir(scratch, recursive=true)
  let archives = [
    (compiler_url, compiler_hash, home),
    (core_url, core_hash, home + "/lib"),
  ]
  for i = 0; i < archives.length(); i = i + 1 {
    let (url, expected, destination) = archives[i]
    let archive = scratch + "/" + i.to_string() + ".tar.gz"
    ignore(
      output("curl", [
        "--fail", "--silent", "--show-error", "--location", "--max-time", "120",
        "--output", archive, url,
      ]),
    )
    guard @fs.file_size(archive) < 128L * 1024L * 1024L else {
      refuse("Archive limit")
    }
    let identity = output("node", [
      "-e", "process.stdout.write(require('crypto').createHash('sha256').update(require('fs').readFileSync(process.argv[1])).digest('hex'))",
      archive,
    ])
    guard identity == expected else {
      refuse("LLVM archive pin changed; do not substitute nightly")
    }
    if !@fs.exists(destination) {
      @fs.mkdir(destination, recursive=true)
    }
    ignore(output("/usr/bin/tar", ["-xf", archive, "-C", destination]))
  }
  for entry in @fs.readdir(home + "/bin") {
    let path = home + "/bin/" + entry
    if @fs.kind(path) is Regular {
      @fs.chmod(path, 0o755)
    }
  }
  if !@fs.exists(home + "/bin/moonx") {
    @fs.symlink(target="moon", home + "/bin/moonx")
  }
  // Only child compiler processes receive this installation. Defaults stay intact.
  @env.set_env_var("MOON_HOME", home)
  @env.set_env_var(
    "PATH",
    home + "/bin:" + @env.get_env_var("PATH").unwrap_or(""),
  )
  @env.unset_env_var("MOON_WORK")
  let repo = @fs.realpath(".")
  patch_core_imports(home + "/lib/core")
  let patched_identity = core_source_identity(repo, home + "/lib/core")
  guard patched_identity == patched_core_identity else {
    refuse("Patched LLVM core changed: " + patched_identity)
  }
  guard output(home + "/bin/moonc", ["-v"]).has_prefix("v" + version + " ") else {
    refuse("LLVM compiler version")
  }
  ignore(
    output(home + "/bin/moon", [
      "-C",
      home + "/lib/core",
      "bundle",
      "--target",
      "llvm",
      "--warn-list",
      "-a",
    ]),
  )
  let identities = @json.parse(
    output("node", [
      "--input-type=module",
      "-e",
      (
        #|import {pathToFileURL} from 'node:url';import {join} from 'node:path';
        #|const [repo,home]=process.argv.slice(1);
        #|const {treeIdentity}=await import(pathToFileURL(join(repo,'apps/morphir/build-provider/identity.mjs')));
        #|const {compilerIdentity}=await import(pathToFileURL(join(repo,'apps/morphir/build-provider/capabilities.mjs')));
        #|console.log(JSON.stringify({compilerIdentity:compilerIdentity(home),coreIdentity:treeIdentity(join(home,'lib/core'),{core:true})}));
      ),
      repo,
      home,
    ]),
  )
  let pin : Json = {
    "profile": "morphir-toolchain-pin-v1",
    "compilerVersion": version,
    "compilerIdentity": text(identities, "compilerIdentity"),
    "coreIdentity": text(identities, "coreIdentity"),
    "platform": "darwin",
    "arch": "arm64",
    "targets": ["llvm"],
    "acquisition": {
      "compilerArchiveIdentity": compiler_hash,
      "coreArchiveIdentity": core_hash,
      "compilerUrl": compiler_url,
      "coreUrl": core_url,
    },
  }
  let path = @env.get_env_var("MORPHIR_LLVM_PIN").unwrap_or(home + "/pin.json")
  @fs.write_file(path, pin.stringify() + "\n")
  if !json_mode.val {
    println(pin.stringify())
  }
  pin
}

///|
fn json_command() -> @argparse.Command {
  @argparse.Command(
    "llvm-setup.mbtx",
    about="Acquire the pinned isolated toolchain without changing its JSON pin schema",
    disable_help_flag=true,
    flags=[
      @argparse.FlagArg("json", required=true),
      @argparse.FlagArg("help", about="Render help without acquisition"),
      @argparse.FlagArg(
        "self-test",
        about="Check the LLVM core patch without acquisition",
      ),
    ],
  )
}

///|
fn self_test_invocation(argv : ArrayView[String]) -> Bool {
  try {
    ignore(
      @argparse.Command(
        "llvm-setup.mbtx",
        disable_help_flag=true,
        disable_help_subcommand=true,
        flags=[@argparse.FlagArg("self-test", required=true)],
      ).parse(argv~, env=Map([])),
    )
    true
  } catch {
    _ => false
  }
}

///|
async fn self_test() -> Unit {
  for
    (before, after) in [
      (
        "#cfg(target=\"native\")", "#cfg(any(target=\"native\", target=\"llvm\"))",
      ),
      (
        "#cfg(any(target=\"native\", target=\"wasm\"))", "#cfg(any(any(target=\"native\", target=\"llvm\"), target=\"wasm\"))",
      ),
      (
        "#cfg(not(target=\"native\"))", "#cfg(not(any(target=\"native\", target=\"llvm\")))",
      ),
      // File targets already include LLVM, and other targets keep their imports.
      ("#cfg(target=\"js\")", "#cfg(target=\"js\")"),
      ("  \"main.mbt\": [ \"native\" ],", "  \"main.mbt\": [ \"native\" ],"),
      ("// target=\"native\"", "// target=\"native\""),
    ] {
    guard llvm_conditional_imports(before + "\nimport {\n}\n") ==
      after + "\nimport {\n}\n" else {
      fail("LLVM core patch changed: " + before)
    }
  }
  let root = @fs.tmpdir(prefix="morphir-llvm-test-")
  defer @fs.rmdir(root, recursive=true)
  @fs.mkdir(root + "/async/process", recursive=true)
  let conditional = "#cfg(target=\"native\")\nimport {\n}\n"
  @fs.write_file(root + "/async/process/moon.pkg", conditional)
  @fs.write_file(root + "/async/process/main.mbt", conditional)
  patch_core_imports(root)
  guard @fs.read_file(root + "/async/process/moon.pkg").text() ==
    llvm_conditional_imports(conditional) &&
    @fs.read_file(root + "/async/process/main.mbt").text() == conditional else {
    fail("LLVM core patch must change only nested moon.pkg files")
  }
  let note = "LLVM setup: conditional-import patch and its file selection passed\n"
  if json_mode.val {
    @stdio.stderr.write(note)
  } else {
    @stdio.stdout.write(note)
  }
}

///|
async fn main {
  let argv = @env.args()[1:]
  json_mode.val = match argv {
    ["--json", ..] | ["--help", "--json", ..] | ["--self-test", "--json"] =>
      true
    _ => false
  }
  // Legacy acquisition ignored argv, so keep that behavior outside JSON mode.
  if !json_mode.val {
    if self_test_invocation(argv) {
      self_test()
    } else {
      ignore(execute())
    }
    return
  }
  try {
    let matches = json_command().parse(argv~, env=Map([]))
    let value = if matches.flags.get("help").unwrap_or(false) {
      succeeded({ "render_help": json_command().render_help() })
    } else if matches.flags.get("self-test").unwrap_or(false) {
      self_test()
      succeeded({ "passed": true })
    } else {
      // The existing pin is already a public JSON success schema.
      execute()
    }
    @stdio.stdout.write(value.stringify() + "\n")
  } catch {
    error => failed(error)
  }
}
