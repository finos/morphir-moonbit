///|
/// Build the actual host package. A build receipt is not GUI qualification.
import {
  "moonbitlang/async@0.22.4",
  "moonbitlang/async@0.22.4/fs",
  "moonbitlang/async@0.22.4/process",
  "moonbitlang/async@0.22.4/stdio",
  "moonbitlang/core/env",
  "moonbitlang/core/json",
  "moonbitlang/core/encoding/utf8",
  "moonbitlang/x@0.5.5/crypto",
}

///|
enum PackageTarget {
  LinuxX64
  WindowsX64
} derive(Eq)

///|
fn PackageTarget::parse(value : String) -> PackageTarget raise {
  match value {
    "linux-x64" => LinuxX64
    "windows-x64" => WindowsX64
    _ => fail("Expected linux-x64 or windows-x64")
  }
}

///|
fn PackageTarget::name(self : PackageTarget) -> String {
  match self {
    LinuxX64 => "linux-x64"
    WindowsX64 => "windows-x64"
  }
}

///|
fn PackageTarget::host(self : PackageTarget) -> String {
  match self {
    LinuxX64 => "linux:x64"
    WindowsX64 => "win32:x64"
  }
}

///|
fn PackageTarget::formats(self : PackageTarget) -> Array[String] {
  match self {
    LinuxX64 => ["--format", "appimage"]
    WindowsX64 => ["--format", "app", "--format", "zip"]
  }
}

///|
fn field(value : Json, key : String) -> Json {
  match value {
    Object(fields) => fields.get(key).unwrap_or(Json::null())
    _ => Json::null()
  }
}

///|
fn text(value : Json, key : String) -> String raise {
  guard field(value, key) is String(value) else {
    fail("Missing pin field: " + key)
  }
  value
}

///|
struct Digest(String)

///|
fn Digest::parse(value : String) -> Digest raise {
  guard value.length() == 64 else { fail("Expected SHA-256 pin") }
  for character in value {
    guard (character >= '0' && character <= '9') ||
      (character >= 'a' && character <= 'f') else {
      fail("Expected lowercase SHA-256 pin")
    }
  }
  Digest(value)
}

///|
fn Digest::matches(self : Digest, bytes : Bytes) -> Bool {
  let Digest(expected) = self
  @crypto.bytes_to_hex_string(@crypto.sha256(bytes)) == expected
}

///|
fn selected_pin(pins : Json, target : PackageTarget) -> Json raise {
  guard field(pins, "formatVersion") == Json::number(1) &&
    field(pins, "targets") is Array(entries) &&
    entries.length() == 2 else {
    fail("Expected the two target package pins")
  }
  let mut selected = None
  let seen : Array[PackageTarget] = []
  for entry in entries {
    let found = PackageTarget::parse(text(entry, "target"))
    guard !seen.contains(found) else { fail("Duplicate target pin") }
    seen.push(found)
    ignore(Digest::parse(text(entry, "cefSha256")))
    if found == target {
      selected = Some(entry)
    }
  }
  guard selected is Some(pin) else { fail("Missing target pin") }
  pin
}

///|
fn check_requirements(pins : Json, pin : Json, actual : Json) -> Unit raise {
  let proton = field(pins, "proton")
  guard text(actual, "proton_version") == text(proton, "version") &&
    text(actual, "platform") == text(pin, "cefPlatform") &&
    text(actual, "cef_archive") == text(pin, "cefArchive") &&
    text(actual, "cef_sha256") == text(pin, "cefSha256") &&
    field(actual, "layout_version") == field(proton, "layoutVersion") else {
    fail(
      "Installed Proton/CEF requirements differ from the reviewed target pins",
    )
  }
}

///|
async fn output(
  program : String,
  args : Array[String],
  cwd~ : String = ".",
) -> String {
  let (status, out, err) = @process.collect_output(program, args, cwd~)
  guard status == 0 else {
    fail(program + " failed: " + err.text() + out.text())
  }
  out.text().trim().to_owned()
}

///|
async fn checked(
  program : String,
  args : Array[String],
  cwd~ : String = ".",
) -> Unit {
  let status = @process.run(
    program,
    args,
    cwd~,
    stdout=@stdio.stdout,
    stderr=@stdio.stderr,
  )
  guard status == 0 else {
    fail(program + " failed with status " + status.to_string())
  }
}

///|
fn restore_environment(name : String, previous : String?) -> Unit {
  match previous {
    Some(value) => @env.set_env_var(name, value)
    None => @env.unset_env_var(name)
  }
}

///|
fn executable_directory(program : String) -> String raise {
  let normalized = program.replace_all(old="\\", new="/")
  guard normalized.strip_suffix("/tar.exe") is Some(directory) else {
    fail("Unexpected Windows archive executable path")
  }
  directory.to_owned()
}

///|
async fn setup_windows_cef(desktop : String, evidence : String) -> Unit {
  let locations = output("where.exe", ["tar"])
  let candidates = locations.split("\n").to_array()
  guard candidates.length() > 0 else { fail("No Windows archive extractor") }
  let original_program = candidates[0].trim().to_owned()
  let mut selected : (String, String)? = None
  for candidate in candidates {
    let program = candidate.trim().to_owned()
    if program.is_empty() {
      continue
    }
    let version = output(program, ["--version"])
    if version.has_prefix("tar (GNU tar)") {
      selected = Some((program, version))
      break
    }
  }
  guard selected is Some((program, version)) else {
    fail("The Windows CEF setup requires the runner's GNU tar")
  }
  let original_directory = executable_directory(original_program)
  let selected_directory = executable_directory(program)
  guard @env.get_env_var("PATH") is Some(previous_path) else {
    fail("Missing build tool search path")
  }
  let previous_options = @env.get_env_var("TAR_OPTIONS")
  let original_link = output("where.exe", ["link"]).split("\n").to_array()[0]
    .trim()
    .to_owned()
  let paths : Array[String] = []
  let mut inserted = original_program == program
  for path in previous_path.split(";") {
    if !inserted &&
      path.to_owned().replace_all(old="\\", new="/").to_lower() ==
      original_directory.to_lower() {
      paths.push(selected_directory)
      inserted = true
    }
    paths.push(path.to_owned())
  }
  guard inserted else {
    fail("Cannot locate the original archive tool in PATH")
  }
  @env.set_env_var("PATH", paths.join(";"))
  defer restore_environment("PATH", Some(previous_path))
  // GNU tar otherwise treats the colon in an absolute Windows archive path as
  // a remote host. Keep this option scoped to the owned CEF setup process.
  @env.set_env_var("TAR_OPTIONS", "--force-local")
  defer restore_environment("TAR_OPTIONS", previous_options)
  guard output("tar", ["--version"]) == version &&
    output("where.exe", ["link"]).split("\n").to_array()[0].trim() ==
    original_link else {
    fail("Archive selection must preserve the native linker selection")
  }
  let diagnostic = @fs.read_file(evidence + "/archive-tools.log").text() +
    "\nScoped CEF extractor: " +
    program +
    "\n" +
    version +
    "\nTAR_OPTIONS: --force-local\nPreserved linker: " +
    original_link +
    "\n"
  @fs.write_file(evidence + "/archive-tools.log", diagnostic)
  println(diagnostic)
  @async.with_timeout(720000, () => {
    checked("proton_cli", ["cef", "setup"], cwd=desktop)
  })
}

///|
async fn acquire_tool(pin : Json, destination : String) -> Unit {
  let digest = Digest::parse(text(pin, "sha256"))
  if @fs.exists(destination) {
    guard @fs.kind(destination, follow_symlink=false) is Regular &&
      digest.matches(@fs.read_file(destination).binary()) else {
      fail(
        "Existing tool differs from pin; refusing to replace it: " + destination,
      )
    }
  } else {
    let scratch = @fs.tmpdir(prefix="morphir-package-tool-")
    defer @fs.rmdir(scratch, recursive=true)
    let download = scratch + "/download"
    checked("curl", [
      "--fail",
      "--location",
      "--silent",
      "--show-error",
      "--max-time",
      "180",
      "--max-filesize",
      "33554432",
      "--output",
      download,
      text(pin, "url"),
    ])
    guard @fs.file_size(download) <= 32L * 1024L * 1024L else {
      fail("Package tool download exceeds its bound")
    }
    let bytes = @fs.read_file(download).binary()
    guard digest.matches(bytes) else {
      fail("Package tool checksum differs from the reviewed pin")
    }
    @fs.write_file(destination, bytes)
  }
  @fs.chmod(destination, 0o755)
}

///|
let acceptance_checks : Json = [
  "empty-descriptor-and-unavailable-native-effects", "native-fallback:compile-fields-json-ion-unsupported-boundary",
  "reload-and-close-revoke-old-session", "hostile-origin-denied", "standalone:compile-fields-json-ion-unsupported-boundary",
  "actual-browser-workers-exit", "real-window-close-and-profile-cleanup",
]

///|
fn check_acceptance(
  receipt : Json,
  target : PackageTarget,
  revision : String,
) -> Unit raise {
  let build = field(receipt, "build")
  guard field(receipt, "profile") == Json("morphir/workbench/packaged-fallback") &&
    field(receipt, "formatVersion") == Json(1) &&
    field(receipt, "target") == Json(target.name()) &&
    field(receipt, "passed") == Json(true) &&
    field(receipt, "checks") == acceptance_checks &&
    field(receipt, "forcedCleanup") == Json(false) &&
    field(receipt, "profileRemoved") == Json(true) &&
    field(receipt, "entryExit") ==
    ({ "code": 0, "signal": Json::null() } : Json) &&
    field(build, "profile") == Json("morphir/workbench/packaged-build") &&
    field(build, "status") == Json("built") &&
    field(build, "qualification") == Json("build-only") &&
    field(build, "revision") == Json(revision) &&
    field(build, "target") == Json(target.name()) else {
    fail(
      "Incomplete, failed or wrong-candidate packaged fallback receipt: " +
      target.name(),
    )
  }
  guard field(receipt, "workersStarted") is Number(started, ..) &&
    started >= 8 &&
    started == started.to_int().to_double() &&
    field(receipt, "workersClosed") == Json(started) else {
    fail("Actual browser worker cleanup was not demonstrated")
  }
  guard field(receipt, "files") is Array(files) &&
    !files.is_empty() &&
    files.length() <= 10000 else {
    fail("Missing package inventory")
  }
  let seen : Array[String] = []
  for file in files {
    let path = text(file, "path")
    guard !path.is_empty() &&
      !path.contains("\\") &&
      !path.contains(":") &&
      path.split("/").all(part => part != "" && part != "." && part != "..") &&
      !seen.contains(path) else {
      fail("Invalid or repeated package inventory path")
    }
    seen.push(path)
    ignore(Digest::parse(text(file, "sha256")))
  }
}

///|
async fn candidate() -> String {
  let revision = output("git", ["rev-parse", "HEAD"])
  if @env.get_env_var("GITHUB_SHA") is Some(expected) {
    guard revision == expected else {
      fail("Checkout differs from the workflow candidate")
    }
  }
  guard output("git", ["status", "--porcelain", "--untracked-files=normal"]).is_empty() else {
    fail("Clean committed candidate required")
  }
  revision
}

///|
async fn accept(
  target : PackageTarget,
  pins : Json,
  pins_source : String,
) -> Unit {
  guard output("bun", ["--print", "process.platform+':'+process.arch"]) ==
    target.host() else {
    fail("Actual selected host required for acceptance")
  }
  let revision = candidate()
  let directory = ".dev/packaged-targets/" + target.name()
  let build = @fs.read_file(directory + "/build.json").json()
  guard field(build, "revision") == Json(revision) &&
    field(build, "target") == Json(target.name()) &&
    field(build, "pinsSha256") ==
    Json(@crypto.bytes_to_hex_string(@crypto.sha256(@utf8.encode(pins_source)))) &&
    field(build, "corePin") == @fs.read_file(text(pins, "toolchainPin")).json() else {
    fail("Build receipt differs from the selected source/core/tool pins")
  }
  check_requirements(
    pins,
    selected_pin(pins, target),
    field(build, "cefRequirements"),
  )
  // The app acceptance reuses the installed CLI's qualified process-group and
  // Windows Job adapter. It owns only its package fixture and performs actual
  // CEF page assertions; no root JavaScript task orchestrator is introduced.
  @async.with_timeout(660000, () => {
    checked("bun", [
      "--check",
      "apps/morphir-workbench/scripts/desktop-platform-test.ts",
      target.name(),
      directory,
    ])
  })
  guard candidate() == revision else {
    fail("Candidate changed during acceptance")
  }
  check_acceptance(
    @fs.read_file(directory + "/acceptance.json").json(),
    target,
    revision,
  )
}

///|
async fn aggregate(
  directory : String,
  pins : Json,
  pins_source : String,
) -> Unit {
  let revision = candidate()
  let receipts : Array[Json] = []
  for target in [LinuxX64, WindowsX64] {
    let receipt = @fs.read_file(
      directory + "/packaged-" + target.name() + "/acceptance.json",
    ).json()
    check_acceptance(receipt, target, revision)
    let build = field(receipt, "build")
    guard field(build, "pinsSha256") ==
      Json(
        @crypto.bytes_to_hex_string(@crypto.sha256(@utf8.encode(pins_source))),
      ) &&
      field(build, "corePin") ==
      @fs.read_file(text(pins, "toolchainPin")).json() else {
      fail("Matrix uses different tool/source pins")
    }
    check_requirements(
      pins,
      selected_pin(pins, target),
      field(build, "cefRequirements"),
    )
    receipts.push(receipt)
  }
  @fs.mkdir(".dev/packaged-targets", recursive=true, allow_exist=true)
  let result : Json = {
    "profile": "morphir/workbench/packaged-fallback-matrix",
    "formatVersion": 1,
    "revision": revision,
    "passed": true,
    "targets": receipts,
  }
  @fs.write_file(".dev/packaged-targets/matrix.json", result.stringify() + "\n")
  println(
    "Both actual target receipts pass on the same candidate; native operation enablement remains separate",
  )
}

///|
fn self_test(pins : Json) -> Unit raise {
  for target in [LinuxX64, WindowsX64] {
    let pin = selected_pin(pins, target)
    let actual : Json = {
      "proton_version": text(field(pins, "proton"), "version"),
      "platform": text(pin, "cefPlatform"),
      "cef_archive": text(pin, "cefArchive"),
      "cef_sha256": text(pin, "cefSha256"),
      "layout_version": field(field(pins, "proton"), "layoutVersion"),
    }
    check_requirements(pins, pin, actual)
    try check_requirements(pins, pin, { "proton_version": "0.0.0" }) catch {
      _ => ()
    } noraise {
      _ => fail("Wrong runtime must be refused")
    }
  }
  try PackageTarget::parse("darwin-arm64") catch {
    _ => ()
  } noraise {
    _ => fail("Cross-host build must not qualify a selected target")
  }
  try Digest::parse("invalid") catch {
    _ => ()
  } noraise {
    _ => fail("Invalid digest must be refused")
  }
  let pin = Digest::parse(
    "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855",
  )
  guard pin.matches(b"") && !pin.matches(b"changed") else {
    fail("Checksum validation must compare actual bytes")
  }
  let fixture : Json = {
    "profile": "morphir/workbench/packaged-fallback",
    "formatVersion": 1,
    "target": "linux-x64",
    "passed": true,
    "checks": acceptance_checks,
    "forcedCleanup": false,
    "profileRemoved": true,
    "entryExit": { "code": 0, "signal": Json::null() },
    "workersStarted": 8,
    "workersClosed": 8,
    "build": {
      "profile": "morphir/workbench/packaged-build",
      "status": "built",
      "qualification": "build-only",
      "revision": "candidate",
      "target": "linux-x64",
    },
    "files": [
      {
        "path": "app.AppImage",
        "sha256": "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855",
      },
    ],
  }
  check_acceptance(fixture, LinuxX64, "candidate")
  for (target, revision) in [(WindowsX64, "candidate"), (LinuxX64, "wrong")] {
    try check_acceptance(fixture, target, revision) catch {
      _ => ()
    } noraise {
      _ => fail("Accepted wrong target or candidate")
    }
  }
  for
    (key, value) in [
      ("passed", Json(false)),
      ("forcedCleanup", Json(true)),
      ("profileRemoved", Json(false)),
      ("workersClosed", Json(7)),
      ("checks", Json::array([])),
      ("files", Json::array([])),
    ] {
    guard @json.parse(fixture.stringify()) is Object(fields) else {
      abort("Fixture object")
    }
    fields.set(key, value)
    try check_acceptance(Json::object(fields), LinuxX64, "candidate") catch {
      _ => ()
    } noraise {
      _ => fail("Accepted missing/failed qualification evidence: " + key)
    }
  }
  println(
    "Package pin, runtime mismatch and checksum checks passed; no host package built",
  )
}

///|
async fn main {
  let pins_path = "tools/packaged-targets-pin.json"
  let pins_source = @fs.read_file(pins_path).text()
  let pins = @json.parse(pins_source)
  let args = @env.args()[1:]
  if args == ["--self-test"] {
    self_test(pins)
    return
  }
  if args is ["accept", target] {
    accept(PackageTarget::parse(target), pins, pins_source)
    return
  }
  if args is ["aggregate", directory] {
    aggregate(directory, pins, pins_source)
    return
  }
  guard args is ["build", target] else {
    fail(
      "Usage: workbench-packaged-targets.mbtx --self-test | build|accept <linux-x64|windows-x64> | aggregate <receipt-directory>",
    )
  }
  let target = PackageTarget::parse(target)
  let pin = selected_pin(pins, target)
  guard output("bun", ["--print", "process.platform+':'+process.arch"]) ==
    target.host() else {
    fail(
      "Build this package on its actual selected operating system and architecture",
    )
  }
  let revision = output("git", ["rev-parse", "HEAD"])
  guard output("git", ["status", "--porcelain", "--untracked-files=normal"]).is_empty() else {
    fail(
      "Commit the candidate sources before creating source-bound package evidence",
    )
  }
  if @env.get_env_var("GITHUB_SHA") is Some(expected) {
    guard revision == expected else {
      fail("Checkout differs from the workflow candidate")
    }
  }
  let compiler = @fs.read_file(text(pins, "toolchainPin")).json()
  let version = output("moonc", ["-v"])
  guard version.has_prefix("v" + text(compiler, "compilerVersion") + " ") else {
    fail("Pinned compiler required")
  }
  checked("mise", ["run", "check:core"])
  let root = @fs.realpath(".")
  let evidence = root + "/.dev/packaged-targets/" + target.name()
  @fs.mkdir(evidence, recursive=true, allow_exist=true)
  guard !@fs.exists(evidence + "/package") &&
    !@fs.exists(evidence + "/build.json") else {
    fail(
      "Use a fresh candidate workspace; refusing to reuse earlier package evidence",
    )
  }
  @env.set_env_var("PROTON_NO_UPDATE_CHECK", "1")
  if target == LinuxX64 {
    let tools = field(pins, "linuxTools")
    @fs.mkdir(evidence + "/tools", allow_exist=true)
    acquire_tool(field(tools, "appimagetool"), evidence + "/tools/appimagetool")
    acquire_tool(field(tools, "runtime"), evidence + "/tools/runtime")
    @env.set_env_var(
      "PATH",
      evidence + "/tools:" + @env.get_env_var("PATH").unwrap_or(""),
    )
    @env.set_env_var("APPIMAGETOOL_RUNTIME_FILE", evidence + "/tools/runtime")
    @env.set_env_var("APPIMAGE_EXTRACT_AND_RUN", "1")
  }
  checked("bun", ["install", "--frozen-lockfile"])
  checked(
    "bun",
    ["install", "--frozen-lockfile"],
    cwd=root + "/apps/morphir-workbench",
  )
  checked("bun", ["run", "build:runtimes"])
  checked("moon", [
    "install",
    "moonbit-community/proton_cli@" + text(field(pins, "proton"), "version"),
  ])
  let desktop = root + "/apps/morphir-workbench-desktop"
  @env.unset_env_var("MOON_WORK")
  checked("moon", ["update"], cwd=desktop)
  let requirements = @json.parse(
    output("proton_cli", ["cef", "requirements"], cwd=desktop),
  )
  check_requirements(pins, pin, requirements)
  if target == WindowsX64 {
    let locations = output("where.exe", ["tar"])
    let version = output("tar", ["--version"])
    let archive_tools = "tar search results:\n" +
      locations +
      "\nSelected tar version:\n" +
      version +
      "\n"
    @fs.write_file(evidence + "/archive-tools.log", archive_tools)
    println(archive_tools)
  }
  // A stalled archive extractor must leave evidence and fail before the outer
  // job deadline, so the always-run artifact step can retain the diagnostics.
  let setup_progress : Json = {
    "revision": revision,
    "target": target.name(),
    "stage": "cef-setup",
    "qualification": "none",
    "cefRequirements": requirements,
  }
  @fs.write_file(
    evidence + "/build-progress.json",
    setup_progress.stringify() + "\n",
  )
  match target {
    WindowsX64 => setup_windows_cef(desktop, evidence)
    LinuxX64 =>
      @async.with_timeout(720000, () => {
        checked("proton_cli", ["cef", "setup"], cwd=desktop)
      })
  }
  let package_progress : Json = {
    "revision": revision,
    "target": target.name(),
    "stage": "package",
    "qualification": "none",
    "cefRequirements": requirements,
  }
  @fs.write_file(
    evidence + "/build-progress.json",
    package_progress.stringify() + "\n",
  )
  checked(
    "proton_cli",
    ["package", "--release", "--output", evidence + "/package"] +
    target.formats(),
    cwd=desktop,
  )
  guard output("git", ["rev-parse", "HEAD"]) == revision &&
    output("git", ["status", "--porcelain", "--untracked-files=normal"]).is_empty() else {
    fail("Candidate sources changed while packaging; refusing a build receipt")
  }
  let receipt : Json = {
    "profile": "morphir/workbench/packaged-build",
    "formatVersion": 1,
    "status": "built",
    "qualification": "build-only",
    "revision": revision,
    "target": target.name(),
    "compiler": version,
    "corePin": compiler,
    "runnerImage": @env.get_env_var("ImageVersion").unwrap_or("local"),
    "cefRequirements": requirements,
    "pinsSha256": @crypto.bytes_to_hex_string(
      @crypto.sha256(@utf8.encode(pins_source)),
    ),
    "outputDirectory": evidence + "/package",
  }
  @fs.write_file(evidence + "/build.json", receipt.stringify() + "\n")
  println("Package built; actual CEF fallback acceptance is still required")
}
