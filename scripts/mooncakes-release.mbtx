----
import {
  "moonbitlang/core/debug",
  "moonbitlang/core/buffer",
  "moonbitlang/core/argparse",
  "moonbitlang/core/env",
  "moonbitlang/core/json",
  "moonbitlang/core/encoding/utf8",
  "moonbitlang/moon_config@0.4.4" @manifest_parser,
  "moonbitlang/lexer@0.4.4/basic",
  "moonbitlang/async@0.22.5",
  "moonbitlang/async@0.22.5/fs",
  "moonbitlang/async@0.22.5/process",
  "moonbitlang/async@0.22.5/stdio",
  "moonbitlang/async@0.22.5/http",
  "moonbitlang/x@0.5.5/sys",
  "moonbitlang/x@0.5.5/crypto",
  "moonbitlang/x@0.5.5/path/posix",
  "moonbitlang/x@0.5.5/path" @host_path,
  "moonbitstack/moonsver@0.1.0" @semver,
  "moonbit-community/zipc@0.2.2",
  "moonrockz/ion@0.6.0/binary",
  "moonrockz/ion@0.6.0/json" @ion_json,
}
----

///|
enum Disposition {
  Public
  Excluded
} derive(Eq, Debug)

///|
struct ModulePath(String) derive(Eq, Debug)

///|
struct ReleaseVersion(String) derive(Eq, Debug)

///|
struct CommitId(String) derive(Eq, Debug)

///|
enum ReleaseMode {
  DryRun
  Publish
} derive(Eq, Debug)

///|
fn ReleaseMode::parse(text : String) -> ReleaseMode raise {
  match text {
    "dry-run" => DryRun
    "publish" => Publish
    _ => raise Refusal(CandidateMismatch("Mode must be dry-run or publish"))
  }
}

///|
struct Candidate {
  version : ReleaseVersion
  commit : CommitId
  mode : ReleaseMode
} derive(Eq, Debug)

///|
enum Problem {
  InvalidPath(String)
  InvalidVersion(String)
  DuplicatePath(String)
  DuplicateName(String)
  UnclassifiedModule(String)
  MissingModule(String)
  IdentityMismatch(String)
  VersionMismatch(String)
  MissingReadme(String)
  InternalDependency(String, String)
  DependencyVersion(String, String)
  Cycle(Array[String])
  InvalidInventory(String)
  InvalidCommit(String)
  TagMismatch(String)
  ManifestSyntax(String)
  MissingLicense(String)
  PrivateModule(String)
  CandidateMismatch(String)
  ArchiveInvalid(String)
} derive(Eq, Debug)

///|
suberror Refusal {
  Refusal(Problem)
} derive(Debug)

///|
impl Show for Refusal with fn output(self, logger) {
  let Refusal(problem) = self
  logger.write_string(@debug.to_string(problem))
}

///|
struct WorkflowRun {
  id : String
  attempt : String
} derive(Eq, Debug)

///|
enum CiState {
  Missing
  Pending
  Passed(WorkflowRun)
  Failed(String)
} derive(Eq, Debug)

///|
fn object_field(value : Json, name : String) -> Json? {
  match value {
    Object(fields) => fields.get(name)
    _ => None
  }
}

///|
fn decimal_id(value : Json) -> String raise {
  match value {
    String(text) if !text.is_empty() &&
      text != "0" &&
      !text.has_prefix("0") &&
      text.iter().all(c => c >= '0' && c <= '9') => text
    Number(number, ..) if number >= 1 &&
      number <= 9007199254740991.0 &&
      number.floor() == number => number.to_int64().to_string()
    _ =>
      raise Refusal(CandidateMismatch("Invalid GitHub run or attempt identity"))
  }
}

///|
fn exact_ci(value : Json, commit : CommitId) -> CiState raise {
  guard object_field(value, "workflow_runs") is Some(Array(runs)) else {
    raise Refusal(CandidateMismatch("GitHub returned no workflow run list"))
  }
  for run in runs {
    let repository = match object_field(run, "repository") {
      Some(value) => string_field(value, "full_name")
      None => None
    }
    let head_repository = match object_field(run, "head_repository") {
      Some(value) => string_field(value, "full_name")
      None => None
    }
    let path = string_field(run, "path")
    if repository != Some("finos/morphir-moonbit") ||
      head_repository != repository ||
      string_field(run, "event") != Some("push") ||
      string_field(run, "head_branch") != Some("main") ||
      string_field(run, "head_sha") != Some(commit.0) ||
      !(path == Some(".github/workflows/ci.yml") ||
      path == Some(".github/workflows/ci.yml@refs/heads/main") ||
      path == Some(".github/workflows/ci.yml@main")) {
      continue
    }
    match string_field(run, "status") {
      Some("queued" | "in_progress" | "waiting" | "pending" | "requested") =>
        return Pending
      Some("completed") => {
        if string_field(run, "conclusion") != Some("success") {
          return Failed("Main push CI did not succeed")
        }
        return Passed({
          id: decimal_id(object_field(run, "id").unwrap_or(Json::null())),
          attempt: decimal_id(
            object_field(run, "run_attempt").unwrap_or(Json::null()),
          ),
        })
      }
      _ => return Failed("Main push CI reported an unknown state")
    }
  }
  Missing
}

///|
fn require_ci_job(
  jobs : Array[Json],
  run : WorkflowRun,
  commit : CommitId,
) -> Unit raise {
  let aggregate = jobs.filter(job => string_field(job, "name") == Some("ci-ok"))
  guard aggregate is [job] &&
    string_field(job, "head_sha") == Some(commit.0) &&
    decimal_id(object_field(job, "run_id").unwrap_or(Json::null())) == run.id &&
    string_field(job, "status") == Some("completed") &&
    string_field(job, "conclusion") == Some("success") else {
    raise Refusal(
      CandidateMismatch("Exact main-push run has no successful ci-ok aggregate"),
    )
  }
}

///|
async fn github_api(path : String) -> Json {
  @async.with_timeout(30000, () => {
    let (code, output, _) = @process.collect_output("gh", [
      "api", "--method", "GET", path,
    ])
    if code != 0 {
      raise Refusal(
        CandidateMismatch(
          "GitHub evidence API is unavailable; publication remains blocked",
        ),
      )
    }
    @json.parse(output.text())
  })
}

///|
async fn gate_ci(commit : CommitId) -> Json {
  let base = "repos/finos/morphir-moonbit/actions/"
  for attempt in 0..<121 {
    let response = github_api(
      base +
      "workflows/ci.yml/runs?branch=main&event=push&head_sha=" +
      commit.0 +
      "&per_page=100",
    )
    match exact_ci(response, commit) {
      Passed(run) => {
        let jobs : Array[Json] = []
        for page in 1..<=10 {
          let response = github_api(
            base +
            "runs/" +
            run.id +
            "/attempts/" +
            run.attempt +
            "/jobs?per_page=100&page=" +
            page.to_string(),
          )
          guard object_field(response, "jobs") is Some(Array(items)) &&
            object_field(response, "total_count") is Some(Number(total, ..)) &&
            total >= 0 &&
            total <= 1000 else {
            raise Refusal(
              CandidateMismatch(
                "GitHub CI job evidence exceeds the bounded page contract",
              ),
            )
          }
          jobs.append(items)
          if jobs.length().to_double() >= total {
            break
          }
          if items.is_empty() {
            raise Refusal(
              CandidateMismatch("GitHub CI job evidence is incomplete"),
            )
          }
        }
        require_ci_job(jobs, run, commit)
        return {
          "profile": "morphir/mooncakes-ci-gate",
          "contractVersion": "0.1.0",
          "repository": "finos/morphir-moonbit",
          "sha": commit.0,
          "workflow": ".github/workflows/ci.yml",
          "event": "push",
          "branch": "main",
          "runId": run.id,
          "runAttempt": run.attempt,
          "aggregate": "ci-ok",
          "state": "succeeded",
        }
      }
      Failed(message) => raise Refusal(CandidateMismatch(message))
      Missing | Pending => {
        if attempt == 120 {
          break
        }
        @async.sleep(10000)
      }
    }
  }
  raise Refusal(
    CandidateMismatch(
      "Successful exact main-push CI was not available within 20 minutes",
    ),
  )
}

///|
fn require_qualification(
  value : Json,
  commit : CommitId,
  run : WorkflowRun,
  required : Array[String],
) -> Unit raise {
  guard object_field(value, "profile") ==
    Some(Json("morphir-ci-qualification-v2")) &&
    string_field(value, "repository") == Some("finos/morphir-moonbit") &&
    string_field(value, "revision") == Some(commit.0) &&
    string_field(value, "runId") == Some(run.id) &&
    string_field(value, "runAttempt") == Some(run.attempt) &&
    string_field(value, "macos") == Some("run") &&
    object_field(value, "macosEvidence") == Some(Json::null()) &&
    !required.is_empty() &&
    object_field(value, "requiredJobs") == Some(Json(required)) &&
    object_field(value, "results") is Some(Object(results)) else {
    raise Refusal(
      CandidateMismatch(
        "Fresh exact-candidate macos:run v2 qualification receipt is required for this workflow attempt",
      ),
    )
  }
  for name in required {
    guard results.get(name) is Some(result) &&
      string_field(result, "result") == Some("success") else {
      raise Refusal(
        CandidateMismatch(
          "Qualification has missing, skipped or failed required job: " + name,
        ),
      )
    }
  }
}

///|
async fn gate_qualification(
  root : String,
  receipt_file : String,
  commit : CommitId,
) -> Json {
  let bytes = @fs.read_file(receipt_file).binary()
  let receipt = @ion_json.to_json(@binary.read_binary_value(bytes[:]))
  let run : WorkflowRun = {
    id: decimal_id(Json(@env.get_env_var("GITHUB_RUN_ID").unwrap_or(""))),
    attempt: decimal_id(
      Json(@env.get_env_var("GITHUB_RUN_ATTEMPT").unwrap_or("")),
    ),
  }
  let definition = @json.parse(
    child("moonx", [
      join_host(root, "scripts/ci-gate.mbtx"),
      "--qualification-jobs",
      "--json",
    ]),
  )
  guard object_field(definition, "base") is Some(Array(base)) &&
    object_field(definition, "macos") is Some(Array(macos)) &&
    !macos.is_empty() else {
    raise Refusal(
      CandidateMismatch("Qualification job definition is unavailable"),
    )
  }
  let required = (base + macos).map(value => {
    match value {
      String(name) => name
      _ => raise Refusal(CandidateMismatch("Invalid qualification job name"))
    }
  })
  require_qualification(receipt, commit, run, required)
  {
    "profile": "morphir/mooncakes-qualification-gate",
    "contractVersion": "0.1.0",
    "sha": commit.0,
    "runId": run.id,
    "runAttempt": run.attempt,
    "receiptSha256": digest(bytes),
    "macos": "run",
    "requiredJobs": required,
    "state": "succeeded",
  }
}

///|
fn workflow_identity(
  version : ReleaseVersion,
  commit : CommitId,
  mode : ReleaseMode,
  repository : String,
  event : String,
  reference : String,
  event_sha : String,
) -> Candidate raise {
  if repository != "finos/morphir-moonbit" ||
    !["push", "workflow_dispatch"].contains(event) ||
    event_sha != commit.0 {
    raise Refusal(
      CandidateMismatch(
        "Workflow context differs from the checked-out release candidate",
      ),
    )
  }
  if mode is Publish && reference != "refs/tags/v" + version.0 {
    raise Refusal(
      CandidateMismatch(
        "Live publication must run on the actual matching release tag; a tag input on main cannot authorize it",
      ),
    )
  }
  { version, commit, mode, }
}

///|
fn require_release_needs(value : Json) -> Unit raise {
  for name in ["plan", "ci", "qualification", "headless"] {
    guard object_field(value, name) is Some(job) &&
      string_field(job, "result") == Some("success") else {
      raise Refusal(
        CandidateMismatch("Release prerequisite did not succeed: " + name),
      )
    }
  }
}

///|
test "publisher refuses missing failed cancelled and skipped prerequisites" {
  let successful : Json = {
    "plan": { "result": "success" },
    "ci": { "result": "success" },
    "qualification": { "result": "success" },
    "headless": { "result": "success" },
  }
  require_release_needs(successful)
  guard successful is Object(fields) else { fail("Expected prerequisites") }
  for name in ["plan", "ci", "qualification", "headless"] {
    for state in ["failure", "cancelled", "skipped", "pending"] {
      let changed = fields.copy()
      changed[name] = { "result": state }
      let refused = try {
        require_release_needs(Json(changed))
        false
      } catch {
        _ => true
      }
      assert_true(refused)
    }
    let changed = fields.copy()
    changed.remove(name)
    let refused = try {
      require_release_needs(Json(changed))
      false
    } catch {
      _ => true
    }
    assert_true(refused)
  }
}

///|
async fn workflow_candidate(
  root : String,
  inspection : Inspection,
  mode : ReleaseMode,
  github_output : Bool,
) -> Json {
  let commit = CommitId::parse(
    child("git", ["-C", root, "rev-parse", "HEAD"]).trim().to_owned(),
  )
  let candidate = workflow_identity(
    inspection.version,
    commit,
    mode,
    @env.get_env_var("GITHUB_REPOSITORY").unwrap_or(""),
    @env.get_env_var("GITHUB_EVENT_NAME").unwrap_or(""),
    @env.get_env_var("GITHUB_REF").unwrap_or(""),
    @env.get_env_var("GITHUB_SHA").unwrap_or(""),
  )
  if candidate.mode is Publish {
    ignore(
      child("git", [
        "-C",
        root,
        "merge-base",
        "--is-ancestor",
        candidate.commit.0,
        "origin/main",
      ]),
    )
  }
  let mode = if candidate.mode is Publish { "publish" } else { "dry-run" }
  if github_output {
    let file = @env.get_env_var("GITHUB_OUTPUT").unwrap_or("")
    if file.is_empty() {
      raise Refusal(CandidateMismatch("GITHUB_OUTPUT is unavailable"))
    }
    @fs.write_file(
      file,
      "sha=" +
      candidate.commit.0 +
      "\ntag=v" +
      candidate.version.0 +
      "\nversion=" +
      candidate.version.0 +
      "\nmode=" +
      mode +
      "\n",
      create_mode=OpenExisting,
      append=true,
    )
  }
  {
    "sha": candidate.commit.0,
    "tag": "v" + candidate.version.0,
    "version": candidate.version.0,
    "mode": mode,
  }
}

///|
fn fixture_ci_run(commit : CommitId) -> Json {
  {
    "id": 42,
    "run_attempt": 1,
    "path": ".github/workflows/ci.yml",
    "repository": { "full_name": "finos/morphir-moonbit" },
    "head_repository": { "full_name": "finos/morphir-moonbit" },
    "head_sha": commit.0,
    "head_branch": "main",
    "event": "push",
    "status": "completed",
    "conclusion": "success",
  }
}

///|
test "release CI accepts only the exact repository main push workflow and successful aggregate" {
  let commit = CommitId::parse("0123456789abcdef0123456789abcdef01234567")
  let value = fixture_ci_run(commit)
  let run : WorkflowRun = { id: "42", attempt: "1", }
  assert_eq(exact_ci({ "workflow_runs": [value] }, commit), Passed(run))
  guard value is Object(fields) else { fail("Expected fixture object") }
  for
    (key, wrong) in [
      ("head_sha", Json("1123456789abcdef0123456789abcdef01234567")),
      ("head_branch", Json("feature")),
      ("event", Json("pull_request")),
      ("path", Json(".github/workflows/nightly-qualification.yml")),
      ("head_repository", Json({ "full_name": "fork/morphir-moonbit" })),
    ] {
    let changed = fields.copy()
    changed[key] = wrong
    assert_eq(exact_ci({ "workflow_runs": [Json(changed)] }, commit), Missing)
  }
  for status in ["queued", "in_progress", "waiting"] {
    let changed = fields.copy()
    changed["status"] = Json(status)
    assert_eq(exact_ci({ "workflow_runs": [Json(changed)] }, commit), Pending)
  }
  let job : Json = {
    "name": "ci-ok",
    "run_id": 42,
    "head_sha": commit.0,
    "status": "completed",
    "conclusion": "success",
  }
  require_ci_job([job], run, commit)
  guard job is Object(job_fields) else { fail("Expected job") }
  for conclusion in ["failure", "cancelled", "skipped", "neutral"] {
    let changed = fields.copy()
    changed["conclusion"] = Json(conclusion)
    assert_true(
      exact_ci({ "workflow_runs": [Json(changed), value] }, commit) is Failed(_),
    )
    let changed_job = job_fields.copy()
    changed_job["conclusion"] = Json(conclusion)
    let refused = try {
      require_ci_job([Json(changed_job)], run, commit)
      false
    } catch {
      _ => true
    }
    assert_true(refused)
  }
  let absent = try {
    require_ci_job([], run, commit)
    false
  } catch {
    _ => true
  }
  assert_true(absent)
}

///|
test "qualification requires fresh current-attempt v2 evidence and every macOS run job" {
  let commit = CommitId::parse("0123456789abcdef0123456789abcdef01234567")
  let run : WorkflowRun = { id: "42", attempt: "2", }
  let required = ["plan", "native", "macos-native"]
  let value : Json = {
    "profile": "morphir-ci-qualification-v2",
    "repository": "finos/morphir-moonbit",
    "revision": commit.0,
    "runId": "42",
    "runAttempt": "2",
    "macos": "run",
    "macosEvidence": Json::null(),
    "requiredJobs": required,
    "results": {
      "plan": { "result": "success" },
      "native": { "result": "success" },
      "macos-native": { "result": "success" },
    },
  }
  require_qualification(value, commit, run, required)
  let encoded = @binary.write_binary_value(@ion_json.Ion(value))
  let decoded = @ion_json.to_json(@binary.read_binary_value(encoded[:]))
  require_qualification(decoded, commit, run, required)
  guard value is Object(fields) else { fail("Expected receipt") }
  let invalids : Array[(String, Json)] = [
    ("profile", "morphir-ci-qualification-v1"),
    ("revision", "1123456789abcdef0123456789abcdef01234567"),
    ("repository", "fork/morphir-moonbit"),
    ("runId", "41"),
    ("runAttempt", "1"),
    ("macos", "reuse"),
    ("macos", "skip"),
    ("macosEvidence", { "fingerprint": "old" }),
    ("requiredJobs", ["plan", "native"]),
    (
      "results",
      { "plan": { "result": "success" }, "native": { "result": "success" } },
    ),
  ]
  for (key, invalid) in invalids {
    let changed = fields.copy()
    changed[key] = invalid
    let refused = try {
      require_qualification(Json(changed), commit, run, required)
      false
    } catch {
      _ => true
    }
    assert_true(refused)
  }
  for state in ["failure", "cancelled", "skipped"] {
    let changed = fields.copy()
    changed["results"] = {
      "plan": { "result": "success" },
      "native": { "result": "success" },
      "macos-native": { "result": state },
    }
    let refused = try {
      require_qualification(Json(changed), commit, run, required)
      false
    } catch {
      _ => true
    }
    assert_true(refused)
  }
}

///|
test "a tag parameter on main cannot authorize a release" {
  let version = ReleaseVersion::parse("0.1.0")
  let commit = CommitId::parse("0123456789abcdef0123456789abcdef01234567")
  ignore(
    workflow_identity(
      version,
      commit,
      DryRun,
      "finos/morphir-moonbit",
      "workflow_dispatch",
      "refs/heads/main",
      commit.0,
    ),
  )
  ignore(
    workflow_identity(
      version,
      commit,
      Publish,
      "finos/morphir-moonbit",
      "push",
      "refs/tags/v0.1.0",
      commit.0,
    ),
  )
  for
    (repository, event, reference, sha) in [
      (
        "finos/morphir-moonbit",
        "workflow_dispatch",
        "refs/heads/main",
        commit.0,
      ),
      ("finos/morphir-moonbit", "push", "refs/tags/v0.2.0", commit.0),
      ("finos/morphir-moonbit", "pull_request", "refs/tags/v0.1.0", commit.0),
      ("fork/morphir-moonbit", "push", "refs/tags/v0.1.0", commit.0),
      (
        "finos/morphir-moonbit", "push", "refs/tags/v0.1.0", "1123456789abcdef0123456789abcdef01234567",
      ),
    ] {
    let refused = try {
      ignore(
        workflow_identity(
          version,
          commit,
          Publish,
          repository,
          event,
          reference,
          sha,
        ),
      )
      false
    } catch {
      _ => true
    }
    assert_true(refused)
  }
}

///|
test "refusal output retains the actionable problem" {
  let error : Error = Refusal(
    CandidateMismatch("Compiler must match source pin"),
  )
  assert_true(error.to_string().contains("Compiler must match source pin"))
}

///|
struct InventoryEntry {
  path : ModulePath
  name : String
  disposition : Disposition
  reason : String
} derive(Eq, Debug)

///|
struct Manifest {
  path : ModulePath
  name : String
  version : String
  dependencies : Map[String, String]
  readme : String?
  license : String?
  visibility : Visibility
} derive(Eq, Debug)

///|
enum Visibility {
  Open
  Private
} derive(Eq, Debug)

///|
struct Inspection {
  inventory : Array[InventoryEntry]
  ordered : Array[Manifest]
  version : ReleaseVersion
}

///|
struct ArchiveEvidence {
  archive_sha256 : String
  content_sha256 : String
  bytes : Int32
  files : Int32
}

///|
struct PackagedModule {
  manifest : Manifest
  archive_path : String
  evidence : ArchiveEvidence
}

///|
struct PackageSet {
  commit : CommitId
  compiler : String
  core_pin_sha256 : String
  packages : Array[PackagedModule]
  isolated_targets : Array[String]
}

///|
enum RegistryState {
  Absent
  Present(String)
  Transient(Int32)
  Rejected(Int32)
  Unavailable
} derive(Eq, Debug)

///|
enum RegistryCheck {
  EvidenceOnly
  Resolvable
} derive(Eq)

///|
enum RegistryPhase {
  Metadata
  Archive
}

///|
fn registry_http_status(
  phase : RegistryPhase,
  status : Int32,
) -> RegistryState? {
  match status {
    200 => None
    404 =>
      Some(
        match phase {
          Metadata => Absent
          Archive => Transient(425)
        },
      )
    408 | 425 | 429 | 500 | 502 | 503 | 504 => Some(Transient(status))
    _ => Some(Rejected(status))
  }
}

///|
test "an occupied version with a missing download is not available for upload" {
  assert_eq(registry_http_status(Metadata, 404), Some(Absent))
  assert_eq(registry_http_status(Archive, 404), Some(Transient(425)))
  assert_eq(
    availability("hash", registry_http_status(Archive, 404).unwrap()),
    Unverified,
  )
  assert_eq(registry_http_status(Archive, 200), None)
  assert_eq(registry_http_status(Metadata, 403), Some(Rejected(403)))
}

///|
enum Availability {
  Available
  Identical
  Conflict
  Unverified
} derive(Eq, Debug)

///|
fn availability(expected : String, observation : RegistryState) -> Availability {
  match observation {
    Absent => Available
    Present(actual) if actual == expected => Identical
    Present(_) => Conflict
    _ => Unverified
  }
}

///|
enum PublicationState {
  Published
  VerifiedExisting
  Failed(String)
  NotAttempted
} derive(Eq, Debug)

///|
struct Publication {
  name : String
  state : PublicationState
} derive(Eq, Debug)

///|
// Upload is invoked at most once per module. Only read-only registry visibility
// and explicitly transient reads are retried. Auth and opaque publish errors
// cannot trigger another upload. Existing versions require byte-identical
// downloaded evidence, never an error-message guess or a lossy ZIP comparison.
async fn publish_sequence(
  mode : ReleaseMode,
  modules : Array[(String, String)],
  observe : async (String) -> RegistryState,
  upload : async (String) -> Int32,
  save : async (Array[Publication]) -> Unit,
  pause : async (Int32) -> Unit,
) -> Array[Publication] {
  if mode is DryRun {
    raise Refusal(CandidateMismatch("A dry-run plan cannot publish"))
  }
  let outcomes = modules.map(pair => Publication::{
    name: pair.0,
    state: NotAttempted,
  })
  save(outcomes)
  // Check the entire inventory before the first upload. This prevents a
  // known conflict in a later consumer from causing avoidable partial release.
  for index, (name, expected) in modules {
    match availability(expected, poll_registry(name, false, observe, pause)) {
      Available => ()
      Identical => {
        outcomes[index] = { name, state: VerifiedExisting, }
        save(outcomes)
      }
      Conflict | Unverified => {
        outcomes[index] = {
          name,
          state: Failed(
            "Inventory-wide registry preflight found conflicting or unavailable evidence; no upload attempted",
          ),
        }
        save(outcomes)
        return outcomes
      }
    }
  }
  for index, (name, expected) in modules {
    let initial = poll_registry(name, false, observe, pause)
    let state = match initial {
      Present(actual) if actual == expected => VerifiedExisting
      Present(_) => Failed("Existing registry archive differs from candidate")
      Absent => {
        outcomes[index] = {
          name,
          state: Failed("Upload started; completion has not been verified"),
        }
        save(outcomes)
        let status = upload(name)
        if status != 0 {
          Failed(
            "Moon publish failed with status " +
            status.to_string() +
            "; upload was not retried",
          )
        } else {
          match poll_registry(name, true, observe, pause) {
            Present(actual) if actual == expected => Published
            Present(_) => Failed("Published archive differs from candidate")
            _ =>
              Failed(
                "Published archive visibility could not be verified within the bounded wait",
              )
          }
        }
      }
      Rejected(status) =>
        Failed("Registry refused evidence with HTTP " + status.to_string())
      _ => Failed("Registry evidence is unavailable; no upload attempted")
    }
    outcomes[index] = { name, state, }
    save(outcomes)
    if state is Failed(_) {
      break
    }
  }
  outcomes
}

///|
async fn poll_registry(
  name : String,
  await_publication : Bool,
  observe : async (String) -> RegistryState,
  pause : async (Int32) -> Unit,
) -> RegistryState {
  let mut observation = Unavailable
  for attempt in 0..<6 {
    observation = observe(name)
    let retry = match observation {
      Transient(_) => true
      Absent => await_publication
      _ => false
    }
    if !retry || attempt == 5 {
      break
    }
    pause(1000 << attempt)
  }
  observation
}

///|
async test "dry-run cannot inspect credentials registry or upload" {
  let mut effects = 0
  let refused = try {
    ignore(
      publish_sequence(
        DryRun,
        [("finos/a", "hash")],
        _ => {
          effects += 1
          Absent
        },
        _ => {
          effects += 1
          0
        },
        _ => effects += 1,
        _ => effects += 1,
      ),
    )
    false
  } catch {
    Refusal(_) => true
    error => raise error
  }
  assert_true(refused)
  assert_eq(effects, 0)
}

///|
async test "identical existing versions are verified and failed dependencies stop consumers" {
  let uploads = []
  let snapshots = []
  let result = publish_sequence(
    Publish,
    [("a", "same"), ("b", "wanted"), ("c", "wanted")],
    name => if name == "a" { Present("same") } else { Present("different") },
    name => {
      uploads.push(name)
      0
    },
    states => snapshots.push(states.copy()),
    _ => (),
  )
  assert_eq(result[0].state, VerifiedExisting)
  assert_true(result[1].state is Failed(_))
  assert_eq(result[2].state, NotAttempted)
  assert_eq(uploads, [])
  assert_eq(snapshots.length(), 3)
  assert_eq(snapshots[0][0].state, NotAttempted)
}

///|
async test "transient reads and index delay retry within bounds with one upload" {
  let reads = [
    Transient(503),
    Absent,
    Absent,
    Absent,
    Transient(429),
    Present("hash"),
  ]
  let mut calls = 0
  let mut uploads = 0
  let delays = []
  let result = publish_sequence(
    Publish,
    [("a", "hash")],
    _ => {
      let value = reads[calls]
      calls += 1
      value
    },
    _ => {
      uploads += 1
      0
    },
    _ => (),
    delay => delays.push(delay),
  )
  assert_eq(result[0].state, Published)
  assert_eq(uploads, 1)
  assert_eq(calls, 6)
  assert_eq(delays, [1000, 1000, 2000])
  let mut unavailable_calls = 0
  let unavailable = publish_sequence(
    Publish,
    [("a", "hash")],
    _ => {
      unavailable_calls += 1
      Transient(503)
    },
    _ => {
      uploads += 1
      0
    },
    _ => (),
    _ => (),
  )
  assert_eq(unavailable_calls, 6)
  assert_eq(uploads, 1)
  assert_true(unavailable[0].state is Failed(_))
}

///|
async test "authentication unknown evidence and opaque publish failure never retry uploads" {
  for initial in [Rejected(401), Rejected(403), Unavailable, Absent] {
    let mut reads = 0
    let mut uploads = 0
    let result = publish_sequence(
      Publish,
      [("a", "hash"), ("consumer", "hash")],
      _ => {
        reads += 1
        initial
      },
      _ => {
        uploads += 1
        1
      },
      _ => (),
      _ => (),
    )
    assert_eq(reads, if initial is Absent { 3 } else { 1 })
    assert_eq(uploads, if initial is Absent { 1 } else { 0 })
    assert_true(result[0].state is Failed(_))
    assert_eq(result[1].state, NotAttempted)
  }
}

///|
async test "a later inventory conflict prevents every new upload" {
  let uploads = []
  let checked = []
  let result = publish_sequence(
    Publish,
    [("dependency", "hash"), ("consumer", "hash")],
    name => {
      checked.push(name)
      if name == "dependency" {
        Absent
      } else {
        Present("other-source")
      }
    },
    name => {
      uploads.push(name)
      0
    },
    _ => (),
    _ => (),
  )
  assert_eq(checked, ["dependency", "consumer"])
  assert_eq(uploads, [])
  assert_eq(result[0].state, NotAttempted)
  assert_true(result[1].state is Failed(_))
}

///|
async test "post-preflight races are rechecked before a consumer upload" {
  let uploaded : Map[String, Bool] = Map([])
  let uploads = []
  let result = publish_sequence(
    Publish,
    [("dependency", "hash"), ("consumer", "hash")],
    name => {
      if name == "consumer" && uploaded.contains("dependency") {
        Present("raced-conflict")
      } else if uploaded.contains(name) {
        Present("hash")
      } else {
        Absent
      }
    },
    name => {
      uploads.push(name)
      uploaded[name] = true
      0
    },
    _ => (),
    _ => (),
  )
  assert_eq(uploads, ["dependency"])
  assert_eq(result[0].state, Published)
  assert_true(result[1].state is Failed(_))
}

///|
async test "partial publication resumes the identical candidate without reuploading dependencies" {
  let uploaded : Map[String, Bool] = Map([])
  let uploads = []
  let mut failed_once = false
  let observe : async (String) -> RegistryState = name => {
    if uploaded.contains(name) {
      Present("hash")
    } else {
      Absent
    }
  }
  let upload : async (String) -> Int32 = name => {
    uploads.push(name)
    if name == "consumer" && !failed_once {
      failed_once = true
      1
    } else {
      uploaded[name] = true
      0
    }
  }
  let modules = [("dependency", "hash"), ("consumer", "hash")]
  let partial = publish_sequence(Publish, modules, observe, upload, _ => (), _ => {
    ()
  })
  assert_eq(partial[0].state, Published)
  assert_true(partial[1].state is Failed(_))
  let resumed = publish_sequence(Publish, modules, observe, upload, _ => (), _ => {
    ()
  })
  assert_eq(resumed[0].state, VerifiedExisting)
  assert_eq(resumed[1].state, Published)
  assert_eq(uploads, ["dependency", "consumer", "consumer"])
  let trace : Json = {
    "simulation": "partial-release-and-identical-candidate-resume",
    "partial": partial.map(row => {
      Json([Json(row.name), Json(@debug.to_string(row.state))])
    }),
    "resumed": resumed.map(row => {
      Json([Json(row.name), Json(@debug.to_string(row.state))])
    }),
    "uploads": uploads,
  }
  println(trace.stringify())
}

///|
fn digest(bytes : Bytes) -> String {
  @crypto.bytes_to_hex_string(@crypto.sha256(bytes))
}

///|
fn identity_source(manifest : Manifest) -> String raise {
  if manifest.name != "finos/morphir" {
    raise Refusal(
      IdentityMismatch("CLI identity generator requires finos/morphir"),
    )
  }
  ignore(ReleaseVersion::parse(manifest.version))
  "// Generated by mise run release:identity. Commit this file; dependency builds skip generation.\n\n" +
  "///|\nlet release_identity : Json = {\n" +
  "  \"name\": \"finos/morphir\",\n" +
  "  // Shared release version from apps/morphir/moon.mod.\n" +
  "  \"version\": " +
  Json(manifest.version).stringify() +
  ",\n}\n"
}

///|
fn require_identity(manifest : Manifest, text : String) -> Unit raise {
  if text.replace_all(old="\r\n", new="\n") != identity_source(manifest) {
    raise Refusal(
      CandidateMismatch(
        "CLI identity is stale; run mise run release:identity and commit release_identity.mbt",
      ),
    )
  }
}

///|
test "committed CLI identity must match its manifest and accepts checkout CRLF" {
  let manifest = fixture_manifest("apps/morphir", "finos/morphir")
  let source = identity_source(manifest)
  require_identity(manifest, source)
  require_identity(manifest, source.replace_all(old="\n", new="\r\n"))
  let stale = try {
    require_identity({ ..manifest, version: "0.2.0", }, source)
    false
  } catch {
    Refusal(_) => true
    error => raise error
  }
  assert_true(stale)
}

///|
async test "owned result writes persist partial outcomes and preserve unrelated files" {
  let directory = @fs.tmpdir(prefix="morphir release report ")
  defer @fs.rmdir(directory, recursive=true)
  let file = join_host(directory, "publication.json")
  let snapshots = []
  let outcomes = publish_sequence(
    Publish,
    [("dependency", "wanted"), ("consumer", "wanted")],
    _ => Absent,
    _ => 1,
    states => {
      let value : Json = {
        "profile": "morphir/mooncakes-publication",
        "states": states.map(state => Json(@debug.to_string(state.state))),
      }
      write_owned_json(file, value, "morphir/mooncakes-publication")
      snapshots.push(@json.parse(@fs.read_file(file).text()))
    },
    _ => (),
  )
  assert_true(outcomes[0].state is Failed(_))
  assert_eq(outcomes[1].state, NotAttempted)
  assert_eq(snapshots.length(), 3)
  assert_true(
    snapshots[1].stringify().contains("completion has not been verified"),
  )
  assert_false(@fs.exists(file + ".tmp"))
  @fs.write_file(file, "unrelated content")
  let refused = try {
    write_owned_json(
      file,
      { "profile": "morphir/mooncakes-publication" },
      "morphir/mooncakes-publication",
    )
    false
  } catch {
    _ => true
  }
  assert_true(refused)
  assert_eq(@fs.read_file(file).text(), "unrelated content")
}

///|
test "registry identity and latest index records must agree before consumers" {
  let manifest = fixture_manifest("pkgs/core", "finos/morphir-core")
  let checksum = "0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"
  let metadata : Json = {
    "module": manifest.name,
    "version": manifest.version,
    "yanked": false,
    "metadata": {
      "name": manifest.name,
      "version": manifest.version,
      "checksum": checksum,
    },
  }
  assert_eq(registry_checksum(metadata, manifest), checksum)
  let wrong = try {
    ignore(registry_checksum(metadata, { ..manifest, version: "0.2.0", }))
    false
  } catch {
    Refusal(_) => true
    error => raise error
  }
  assert_true(wrong)
  let present : Json = { "version": "0.1.0", "checksum": checksum }
  let yanked : Json = {
    "version": "0.1.0",
    "checksum": checksum,
    "yanked": true,
  }
  assert_eq(
    index_checksum(present.stringify() + "\n" + yanked.stringify(), "0.1.0"),
    None,
  )
  assert_eq(
    index_checksum(yanked.stringify() + "\n" + present.stringify(), "0.1.0"),
    Some(checksum),
  )
  assert_eq(index_checksum(present.stringify(), "0.2.0"), None)
}

///|
test "candidate proof refuses changed package bytes source and compiler" {
  let manifest = fixture_manifest("pkgs/core", "finos/morphir-core")
  let packages : PackageSet = {
    commit: CommitId::parse("0123456789abcdef0123456789abcdef01234567"),
    compiler: "0.10.17+d971670cd",
    core_pin_sha256: "core-pin",
    isolated_targets: ["wasm", "wasm-gc", "js", "native"],
    packages: [
      {
        manifest,
        archive_path: ".dev/mooncakes-release/test.zip",
        evidence: {
          archive_sha256: "archive",
          content_sha256: "content",
          bytes: 1,
          files: 1,
        },
      },
    ],
  }
  let plan : Json = { "packages": package_set_json(packages) }
  require_package_proof(plan, packages)
  for
    changed in [
      { ..packages, compiler: "changed", },
      { ..packages, core_pin_sha256: "changed", },
      {
        ..packages,
        commit: CommitId::parse("1123456789abcdef0123456789abcdef01234567"),
      },
      {
        ..packages,
        packages: [
          {
            ..packages.packages[0],
            evidence: {
              ..packages.packages[0].evidence,
              archive_sha256: "changed",
            },
          },
        ],
      },
    ] {
    let refused = try {
      require_package_proof(plan, changed)
      false
    } catch {
      Refusal(_) => true
      error => raise error
    }
    assert_true(refused)
  }
}

///|
fn forbidden_archive_path(path : String) -> Bool {
  path
  .split("/")
  .any(part => {
    [
      "_build", "target", ".git", ".mooncakes", "node_modules", ".dev", "credentials.json",
      ".env",
    ].contains(part.to_owned())
  }) ||
  path.has_prefix(".morphir/logs/")
}

///|
// Inspect archives produced by the pinned Moon invocation, not arbitrary
// registry archives. Existing-version proof must match a raw registry checksum
// or a verified candidate-bound publication receipt; a ZIP map alone cannot
// prove that an external archive had no duplicate entries.
fn inspect_archive(expected : Manifest, bytes : Bytes) -> ArchiveEvidence raise {
  let archive = @zipc.Archive::from_bytes(bytes)
  let entries = archive.to_array()
  entries.sort_by((left, right) => left.path().lexical_compare(right.path()))
  let contents : Map[String, Bytes] = Map([])
  let facts : Array[Json] = []
  for entry in entries {
    let raw = entry.path()
    let path = if raw.has_suffix("/") {
      raw[:raw.length() - 1].to_owned()
    } else {
      raw
    }
    ignore(ModulePath::parse(path))
    if forbidden_archive_path(path) {
      raise Refusal(ArchiveInvalid("Forbidden package content: " + path))
    }
    if (entry.mode() & 0o170000) == 0o120000 {
      raise Refusal(
        ArchiveInvalid(
          "Source archive must contain files, not symbolic links: " + path,
        ),
      )
    }
    match entry.kind() {
      Dir =>
        facts.push(
          Json::array([Json(path), Json("directory"), Json(entry.mode())]),
        )
      File(file) => {
        let data = file.to_bytes()
        contents[path] = data
        facts.push(
          Json::array([
            Json(path),
            Json("file"),
            Json(entry.mode()),
            Json(digest(data)),
          ]),
        )
        if path != "moon.mod" &&
          (path.has_suffix("/moon.mod") || path.has_suffix("moon.mod.json")) {
          raise Refusal(
            ArchiveInvalid("Unexpected nested/legacy module: " + path),
          )
        }
      }
    }
  }
  guard contents.get("moon.mod") is Some(manifest_bytes) else {
    raise Refusal(ArchiveInvalid("Archive has no moon.mod: " + expected.name))
  }
  let actual = decode_manifest(expected.path, @utf8.decode(manifest_bytes))
  if actual != expected {
    raise Refusal(
      ArchiveInvalid(
        "Packaged manifest differs from inspected source: " + expected.name,
      ),
    )
  }
  if expected.name == "finos/morphir" {
    guard contents.get("cli/release_identity.mbt") is Some(identity) else {
      raise Refusal(
        ArchiveInvalid(
          "CLI archive must include committed release_identity.mbt",
        ),
      )
    }
    require_identity(expected, @utf8.decode(identity))
  }
  for required in ["LICENSE", expected.readme.unwrap()] {
    if !contents.contains(required) {
      raise Refusal(
        ArchiveInvalid("Missing required archive file: " + required),
      )
    }
  }
  for path, data in contents {
    if path != "moon.pkg" && !path.has_suffix("/moon.pkg") {
      continue
    }
    guard archive_package_config(path, @utf8.decode(data)) is Object(fields) else {
      raise Refusal(ArchiveInvalid(path))
    }
    match fields.get("native-stub") {
      None => ()
      Some(Array(stubs)) =>
        for stub in stubs {
          guard stub is String(file) else {
            raise Refusal(ArchiveInvalid("Invalid native stub in " + path))
          }
          let parent = match path.rev_find("/") {
            Some(at) => path[:at].to_owned()
            None => "."
          }
          let resolved = @posix.Path(parent + "/" + file).normalize().0
          ignore(ModulePath::parse(resolved))
          if !contents.contains(resolved) {
            raise Refusal(ArchiveInvalid("Missing native stub: " + resolved))
          }
        }
      _ => raise Refusal(ArchiveInvalid("Invalid native-stub list: " + path))
    }
  }
  {
    archive_sha256: digest(bytes),
    content_sha256: digest(@utf8.encode(Json::array(facts).stringify())),
    bytes: bytes.length(),
    files: contents.length(),
  }
}

///|
fn archive_package_config(path : String, source : String) -> Json raise {
  let (ast, reports) = @manifest_parser.parse_moon_pkg(name=path, source)
  // Moon 0.10.17 formats this option as a top-level underscore alias. The
  // public parser preserves its AST but reports that spelling as unknown.
  // Accept only that exact report at the one validated value's location.
  // All syntax, duplicate-key and unrelated option reports remain fatal.
  let mut alias_location = None
  let normalized = match ast {
    Obj(fields, loc~) => {
      let fields = fields
        .to_array()
        .map(field => {
          let (key, value) = field
          if key != "max_concurrent_tests" {
            return field
          }
          if alias_location is Some(_) {
            raise Refusal(
              ArchiveInvalid("Duplicate test concurrency in " + path),
            )
          }
          guard value is Float(text, ..) &&
            @json.parse(text) is Number(number, ..) &&
            number >= 1 &&
            number <= 2147483647.0 &&
            number.floor() == number else {
            raise Refusal(ArchiveInvalid("Invalid test concurrency in " + path))
          }
          alias_location = Some(value.loc())
          ("max-concurrent-tests", value)
        })
      @manifest_parser.Ast::Obj(Vector(fields), loc~)
    }
    _ => ast
  }
  let retained = reports.filter(report => {
    !(report.msg ==
    "Invalid moon.pkg config: unexpected key `max_concurrent_tests`." &&
    alias_location == Some(report.loc))
  })
  retained.append(@manifest_parser.validate_moon_pkg(normalized))
  if !retained.is_empty() {
    raise Refusal(
      ArchiveInvalid(
        "Invalid package configuration: " +
        path +
        ": " +
        retained.map(report => report.msg).join("; "),
      ),
    )
  }
  Json(normalized)
}

///|
fn ModulePath::parse(text : String) -> ModulePath raise Refusal {
  if text.is_empty() ||
    text.has_prefix("/") ||
    text.contains("\\") ||
    text.contains(":") ||
    text.to_array().any(c => c.to_int() < 32) {
    raise Refusal(InvalidPath(text))
  }
  if text != "." &&
    text.split("/").any(part => part.is_empty() || part == "." || part == "..") {
    raise Refusal(InvalidPath(text))
  }
  ModulePath(text)
}

///|
fn ReleaseVersion::parse(text : String) -> ReleaseVersion raise Refusal {
  let parsed = @semver.Version::parse(text, syntax=@semver.Syntax::strict()) catch {
    _ => raise Refusal(InvalidVersion(text))
  }
  if !parsed.prerelease().is_empty() ||
    !parsed.build().is_empty() ||
    parsed.to_string() != text {
    raise Refusal(InvalidVersion(text))
  }
  ReleaseVersion(text)
}

///|
fn CommitId::parse(text : String) -> CommitId raise Refusal {
  if text.length() != 40 ||
    !text.to_array().all(c => (c >= '0' && c <= '9') || (c >= 'a' && c <= 'f')) {
    raise Refusal(InvalidCommit(text))
  }
  CommitId(text)
}

///|
fn Candidate::from_input(
  version : String,
  tag : String,
  sha : String,
  mode : ReleaseMode,
) -> Candidate raise Refusal {
  let version = ReleaseVersion::parse(version)
  let ReleaseVersion(value) = version
  if tag != "v" + value {
    raise Refusal(TagMismatch(tag))
  }
  { version, commit: CommitId::parse(sha), mode, }
}

///|
fn public_module_name(name : String) -> Bool {
  if name == "finos/morphir" {
    return true
  }
  guard name.strip_prefix("finos/morphir-") is Some(suffix) &&
    !suffix.is_empty() else {
    return false
  }
  suffix
  .iter()
  .all(c => {
    (c >= 'a' && c <= 'z') ||
    (c >= 'A' && c <= 'Z') ||
    (c >= '0' && c <= '9') ||
    c == '-' ||
    c == '_'
  })
}

///|
fn publish_order(
  inventory : Array[InventoryEntry],
  manifests : Array[Manifest],
  discovered : Array[ModulePath],
  version : ReleaseVersion,
) -> Array[Manifest] raise Refusal {
  let paths : Map[String, InventoryEntry] = Map([])
  let identities : Map[String, InventoryEntry] = Map([])
  for entry in inventory {
    let ModulePath(path) = entry.path
    if paths.contains(path) {
      raise Refusal(DuplicatePath(path))
    }
    if identities.contains(entry.name) {
      raise Refusal(DuplicateName(entry.name))
    }
    if entry.reason.trim().is_empty() || entry.name.is_empty() {
      raise Refusal(InvalidInventory(path))
    }
    if entry.disposition is Public &&
      (path == "." || !public_module_name(entry.name)) {
      raise Refusal(InvalidInventory(path))
    }
    paths[path] = entry
    identities[entry.name] = entry
  }
  for ModulePath(path) in discovered {
    if !paths.contains(path) {
      raise Refusal(UnclassifiedModule(path))
    }
  }
  let by_path : Map[String, Manifest] = Map([])
  for manifest in manifests {
    let ModulePath(path) = manifest.path
    if by_path.contains(path) {
      raise Refusal(DuplicatePath(path))
    }
    if !paths.contains(path) {
      raise Refusal(UnclassifiedModule(path))
    }
    by_path[path] = manifest
  }
  let public_modules : Map[String, Manifest] = Map([])
  let ReleaseVersion(expected) = version
  for entry in inventory {
    let ModulePath(path) = entry.path
    guard discovered.contains(entry.path) && by_path.get(path) is Some(manifest) else {
      raise Refusal(MissingModule(path))
    }
    if manifest.name != entry.name {
      raise Refusal(IdentityMismatch(path))
    }
    if entry.disposition is Excluded {
      continue
    }
    if manifest.visibility is Private {
      raise Refusal(PrivateModule(manifest.name))
    }
    if manifest.version != expected {
      raise Refusal(VersionMismatch(manifest.name))
    }
    match manifest.readme {
      None | Some("") => raise Refusal(MissingReadme(manifest.name))
      Some(path) => ignore(ModulePath::parse(path))
    }
    public_modules[manifest.name] = manifest
    if manifest.license is (None | Some("")) {
      raise Refusal(MissingLicense(manifest.name))
    }
  }
  if public_modules.is_empty() {
    raise Refusal(InvalidInventory("No public modules"))
  }
  for name, manifest in public_modules {
    for dependency, pin in manifest.dependencies {
      if !dependency.has_prefix("finos/") {
        continue
      }
      if !public_modules.contains(dependency) {
        raise Refusal(InternalDependency(name, dependency))
      }
      if pin != expected {
        raise Refusal(DependencyVersion(name, dependency))
      }
    }
  }
  let mut pending = public_modules.keys().to_array()
  pending.sort_by((left, right) => left.lexical_compare(right))
  let completed : Map[String, Bool] = Map([])
  let ordered = []
  while !pending.is_empty() {
    let next = pending
      .iter()
      .filter(name => {
        public_modules[name].dependencies
        .keys()
        .all(dependency => {
          !dependency.has_prefix("finos/") || completed.contains(dependency)
        })
      })
      .next()
    guard next is Some(name) else { raise Refusal(Cycle(pending)) }
    ordered.push(public_modules[name])
    completed[name] = true
    pending = pending.filter(other => other != name)
  }
  ordered
}

///|
fn fixture_entry(
  path : String,
  name : String,
  disposition~ : Disposition = Public,
) -> InventoryEntry raise Refusal {
  {
    path: ModulePath::parse(path),
    name,
    disposition,
    reason: "Fixture policy",
  }
}

///|
fn fixture_manifest(
  path : String,
  name : String,
  dependencies~ : Map[String, String] = Map([]),
  version~ : String = "0.1.0",
  readme~ : String? = Some("README.md"),
  license~ : String? = Some("Apache-2.0"),
  visibility~ : Visibility = Open,
) -> Manifest raise Refusal {
  {
    path: ModulePath::parse(path),
    name,
    version,
    dependencies,
    readme,
    license,
    visibility,
  }
}

///|
fn refused(operation : () -> Unit raise Refusal) -> Problem? {
  try {
    operation()
    None
  } catch {
    Refusal(problem) => Some(problem)
  }
}

///|
test "release paths and versions refuse unsafe or non-release identities" {
  for
    text in [
      "", "/repo", "../repo", "a/../b", "a//b", "a/./b", "C:/repo", "a\\b", "a\nb",
    ] {
    assert_eq(
      refused(fn() raise Refusal { ignore(ModulePath::parse(text)) }),
      Some(InvalidPath(text)),
    )
  }
  for
    text in [
      "", "v0.1.0", "01.0.0", "0.1", "0.1.0-rc.1", "0.1.0+build", " 0.1.0",
    ] {
    assert_eq(
      refused(fn() raise Refusal { ignore(ReleaseVersion::parse(text)) }),
      Some(InvalidVersion(text)),
    )
  }
  assert_eq(ReleaseVersion::parse("0.1.0"), ReleaseVersion("0.1.0"))
}

///|
test "candidate binds the exact release tag and full commit identity" {
  let sha = "a".repeat(40)
  let candidate = Candidate::from_input("0.1.0", "v0.1.0", sha, DryRun)
  assert_eq(candidate.mode, DryRun)
  assert_eq(candidate.commit, CommitId(sha))
  for tag in ["0.1.0", "v0.2.0", "main", "v0.1.0 "] {
    assert_eq(
      refused(fn() raise Refusal {
        ignore(Candidate::from_input("0.1.0", tag, sha, Publish))
      }),
      Some(TagMismatch(tag)),
    )
  }
  for sha in ["", "main", "abc123", "A".repeat(40), "g".repeat(40)] {
    assert_eq(
      refused(fn() raise Refusal { ignore(CommitId::parse(sha)) }),
      Some(InvalidCommit(sha)),
    )
  }
}

///|
test "changed manifest identity cannot borrow an inventory entry" {
  let item = fixture_entry("pkgs/core", "finos/morphir-core")
  assert_eq(
    refused(fn() raise Refusal {
      ignore(
        publish_order(
          [item],
          [fixture_manifest("pkgs/core", "finos/morphir-other")],
          [item.path],
          ReleaseVersion::parse("0.1.0"),
        ),
      )
    }),
    Some(IdentityMismatch("pkgs/core")),
  )
}

///|
test "dependency order is deterministic and puts the CLI after its dependencies" {
  let inventory = [
    fixture_entry("apps/morphir", "finos/morphir"),
    fixture_entry("pkgs/core", "finos/morphir-core"),
    fixture_entry("pkgs/extra", "finos/morphir-extra"),
  ]
  let core = fixture_manifest("pkgs/core", "finos/morphir-core")
  let extra = fixture_manifest("pkgs/extra", "finos/morphir-extra")
  let cli = fixture_manifest("apps/morphir", "finos/morphir", dependencies={
    "finos/morphir-core": "0.1.0",
  })
  let discovered = inventory.map(item => item.path)
  let version = ReleaseVersion::parse("0.1.0")
  let names = publish_order(inventory, [cli, extra, core], discovered, version).map(manifest => {
      manifest.name
    },
  )
  assert_eq(names, [
    "finos/morphir-core", "finos/morphir", "finos/morphir-extra",
  ])
  assert_eq(
    publish_order(
      inventory.rev(),
      [core, cli, extra],
      discovered.rev(),
      version,
    ).map(manifest => manifest.name),
    names,
  )
}

///|
test "every discovered manifest needs an explicit inventory disposition" {
  let item = fixture_entry("pkgs/core", "finos/morphir-core")
  let manifest = fixture_manifest("pkgs/core", "finos/morphir-core")
  let version = ReleaseVersion::parse("0.1.0")
  assert_eq(
    refused(fn() raise Refusal {
      ignore(
        publish_order(
          [item],
          [manifest],
          [item.path, ModulePath::parse("pkgs/new")],
          version,
        ),
      )
    }),
    Some(UnclassifiedModule("pkgs/new")),
  )
  assert_eq(
    refused(fn() raise Refusal {
      ignore(publish_order([item], [manifest], [], version))
    }),
    Some(MissingModule("pkgs/core")),
  )
}

///|
test "duplicate paths and duplicate module identities are refused" {
  let item = fixture_entry("pkgs/core", "finos/morphir-core")
  let other = fixture_entry("pkgs/other", "finos/morphir-core")
  let manifest = fixture_manifest("pkgs/core", "finos/morphir-core")
  let version = ReleaseVersion::parse("0.1.0")
  assert_eq(
    refused(fn() raise Refusal {
      ignore(publish_order([item, item], [manifest], [item.path], version))
    }),
    Some(DuplicatePath("pkgs/core")),
  )
  assert_eq(
    refused(fn() raise Refusal {
      ignore(
        publish_order(
          [item, other],
          [manifest],
          [item.path, other.path],
          version,
        ),
      )
    }),
    Some(DuplicateName("finos/morphir-core")),
  )
}

///|
test "public consumers cannot depend on unknown or excluded FINOS modules" {
  let item = fixture_entry("pkgs/core", "finos/morphir-core")
  let excluded = fixture_entry(
    "tools/private",
    "finos/morphir-private",
    disposition=Excluded,
  )
  let private_manifest = fixture_manifest(
    "tools/private", "finos/morphir-private",
  )
  let version = ReleaseVersion::parse("0.1.0")
  for dep in ["finos/morphir-missing", "finos/morphir-private"] {
    let manifest = fixture_manifest(
      "pkgs/core",
      "finos/morphir-core",
      dependencies=Map([(dep, "0.1.0")]),
    )
    assert_eq(
      refused(fn() raise Refusal {
        ignore(
          publish_order(
            [item, excluded],
            [manifest, private_manifest],
            [item.path, excluded.path],
            version,
          ),
        )
      }),
      Some(InternalDependency("finos/morphir-core", dep)),
    )
  }
}

///|
test "shared version and internal dependency pins must match the candidate" {
  let a = fixture_entry("pkgs/a", "finos/morphir-a")
  let b = fixture_entry("pkgs/b", "finos/morphir-b")
  let ma = fixture_manifest("pkgs/a", "finos/morphir-a")
  let version = ReleaseVersion::parse("0.1.0")
  assert_eq(
    refused(fn() raise Refusal {
      ignore(
        publish_order(
          [a],
          [fixture_manifest("pkgs/a", "finos/morphir-a", version="0.2.0")],
          [a.path],
          version,
        ),
      )
    }),
    Some(VersionMismatch("finos/morphir-a")),
  )
  assert_eq(
    refused(fn() raise Refusal {
      ignore(
        publish_order(
          [a, b],
          [
            ma,
            fixture_manifest("pkgs/b", "finos/morphir-b", dependencies={
              "finos/morphir-a": "0.2.0",
            }),
          ],
          [a.path, b.path],
          version,
        ),
      )
    }),
    Some(DependencyVersion("finos/morphir-b", "finos/morphir-a")),
  )
}

///|
test "cycles and absent declared readmes fail before packaging" {
  let a = fixture_entry("pkgs/a", "finos/morphir-a")
  let b = fixture_entry("pkgs/b", "finos/morphir-b")
  let ma = fixture_manifest("pkgs/a", "finos/morphir-a", dependencies={
    "finos/morphir-b": "0.1.0",
  })
  let mb = fixture_manifest("pkgs/b", "finos/morphir-b", dependencies={
    "finos/morphir-a": "0.1.0",
  })
  let version = ReleaseVersion::parse("0.1.0")
  assert_eq(
    refused(fn() raise Refusal {
      ignore(publish_order([a, b], [ma, mb], [a.path, b.path], version))
    }),
    Some(Cycle(["finos/morphir-a", "finos/morphir-b"])),
  )
  assert_eq(
    refused(fn() raise Refusal {
      ignore(
        publish_order(
          [a],
          [fixture_manifest("pkgs/a", "finos/morphir-a", readme=None)],
          [a.path],
          version,
        ),
      )
    }),
    Some(MissingReadme("finos/morphir-a")),
  )
}

///|
fn string_field(value : Json, name : String) -> String? {
  match value {
    Object(fields) =>
      match fields.get(name) {
        Some(String(text)) => Some(text)
        _ => None
      }
    _ => None
  }
}

///|
fn required_string(value : Json, name : String) -> String raise Refusal {
  match string_field(value, name) {
    Some(text) => text
    None => raise Refusal(InvalidInventory("Missing string field: " + name))
  }
}

///|
fn decode_inventory(value : Json) -> Array[InventoryEntry] raise Refusal {
  guard value is Object(fields) &&
    string_field(value, "profile") == Some("morphir/mooncakes-inventory") &&
    string_field(value, "contractVersion") == Some("0.1.0") &&
    fields.get("modules") is Some(Array(items)) else {
    raise Refusal(
      InvalidInventory("Expected morphir/mooncakes-inventory 0.1.0"),
    )
  }
  items.map(item => {
    let disposition = match required_string(item, "disposition") {
      "public" => Public
      "excluded" => Excluded
      text => raise Refusal(InvalidInventory("Unknown disposition: " + text))
    }
    {
      path: ModulePath::parse(required_string(item, "path")),
      name: required_string(item, "name"),
      disposition,
      reason: required_string(item, "reason"),
    }
  })
}

///|
fn decode_manifest(
  path : ModulePath,
  source : String,
) -> Manifest raise Refusal {
  let ModulePath(directory) = path
  let (ast, reports) = @manifest_parser.parse_moon_mod(
    name=directory + "/moon.mod",
    source,
  )
  if !reports.is_empty() {
    let messages = reports
      .map(fn(report : @basic.Report) { report.msg })
      .join("; ")
    raise Refusal(ManifestSyntax(directory + ": " + messages))
  }
  let value = Json(ast)
  guard value is Object(fields) && fields.get("name") is Some(String(name)) else {
    raise Refusal(ManifestSyntax(directory + ": missing module name"))
  }
  let dependencies : Map[String, String] = Map([])
  match fields.get("deps") {
    None => ()
    Some(Object(deps)) =>
      for dependency, pin in deps {
        guard pin is String(text) else {
          raise Refusal(
            ManifestSyntax(
              directory + ": dependency pin must be a string: " + dependency,
            ),
          )
        }
        dependencies[dependency] = text
      }
    _ =>
      raise Refusal(
        ManifestSyntax(directory + ": dependencies must be an object"),
      )
  }
  let visibility = match fields.get("private") {
    Some(True) => Private
    None | Some(False) => Open
    _ => raise Refusal(ManifestSyntax(directory + ": private must be boolean"))
  }
  {
    path,
    name,
    dependencies,
    visibility,
    version: string_field(value, "version").unwrap_or(""),
    readme: string_field(value, "readme"),
    license: string_field(value, "license"),
  }
}

///|
async fn child(program : String, args : Array[String]) -> String {
  let (code, output, error_output) = @process.collect_output(program, args)
  if code != 0 {
    raise Failure("Child failed (\{code}): \{program}\n" + error_output.text())
  }
  output.text()
}

///|
async fn require_clean_sources(
  root : String,
  inspection : Inspection,
) -> CommitId {
  let paths = inspection.inventory
    .filter(entry => entry.disposition is Public)
    .map(entry => entry.path.0)
  let status = child(
    "git",
    [
      "-C", root, "status", "--porcelain=v1", "--untracked-files=normal", "--", "scripts/mooncakes-modules.json",
      "tools/moonbit-core-pin.json", ".gitignore", ..paths,
    ],
  )
  if !status.is_empty() {
    raise Refusal(
      CandidateMismatch(
        "Public source, inventory and toolchain pin must be clean before packaging",
      ),
    )
  }
  CommitId::parse(
    child("git", ["-C", root, "rev-parse", "HEAD"]).trim().to_owned(),
  )
}

///|
async fn compiler_for(root : String, commit : CommitId) -> (String, String) {
  if @env.get_env_var("MOON_CORE_OVERRIDE") is Some(value) && !value.is_empty() {
    raise Refusal(
      CandidateMismatch(
        "Release checks require the stock core; unset MOON_CORE_OVERRIDE",
      ),
    )
  }
  let source = child("git", [
    "-C",
    root,
    "show",
    commit.0 + ":tools/moonbit-core-pin.json",
  ])
  let pin = @json.parse(source)
  if string_field(pin, "profile") != Some("morphir/moonbit/core-pin") {
    raise Refusal(CandidateMismatch("Unknown compiler/core pin contract"))
  }
  let expected = required_string(pin, "compilerVersion")
  let versions = @json.parse(child("moon", ["version", "--all", "--json"]))
  guard versions is Object(fields) && fields.get("items") is Some(Array(items)) else {
    raise Refusal(CandidateMismatch("Moon did not report toolchain versions"))
  }
  let reported = items
    .iter()
    .filter(item => string_field(item, "name") == Some("moonc"))
    .next()
  guard reported is Some(record) &&
    string_field(record, "version") is Some(actual) &&
    actual.split(" ").next() == Some("v" + expected) else {
    raise Refusal(
      CandidateMismatch("Compiler must match source pin " + expected),
    )
  }
  (expected, digest(@utf8.encode(source)))
}

///|
async fn snapshot_public_sources(
  root : String,
  stage : String,
  inspection : Inspection,
  commit : CommitId,
) -> Unit {
  let public_paths = inspection.inventory
    .filter(entry => entry.disposition is Public)
    .map(entry => entry.path.0)
  let archive_path = join_host(stage, "source.zip")
  ignore(
    child(
      "git",
      [
        "-C",
        root,
        "archive",
        "--format=zip",
        "--output=" + archive_path,
        commit.0,
        "--",
        ".gitignore",
        ..public_paths,
      ],
    ),
  )
  let archive = @zipc.Archive::from_bytes(@fs.read_file(archive_path).binary())
  for entry in archive.to_array() {
    let raw = entry.path()
    let path = if raw.has_suffix("/") {
      raw[:raw.length() - 1].to_owned()
    } else {
      raw
    }
    ignore(ModulePath::parse(path))
    let allowed = path == ".gitignore" ||
      public_paths.any(selected => {
        path == selected || path.has_prefix(selected + "/")
      }) ||
      (
        entry.is_dir() &&
        public_paths.any(selected => selected.has_prefix(path + "/"))
      )
    if !allowed || (entry.mode() & 0o170000) == 0o120000 {
      raise Refusal(
        ArchiveInvalid("Unexpected source snapshot member: " + path),
      )
    }
    write_member(stage, entry)
  }
  @fs.write_file(
    join_host(stage, "moon.work"),
    "members = " + Json(public_paths).stringify() + "\n",
  )
  @fs.remove(archive_path)
}

///|
async fn write_member(directory : String, entry : @zipc.Member) -> Unit {
  let raw = entry.path()
  let path = if raw.has_suffix("/") {
    raw[:raw.length() - 1].to_owned()
  } else {
    raw
  }
  ignore(ModulePath::parse(path))
  if (entry.mode() & 0o170000) == 0o120000 || forbidden_archive_path(path) {
    raise Refusal(ArchiveInvalid("Unsafe snapshot member: " + path))
  }
  let destination = join_host(directory, path)
  match entry.kind() {
    Dir => @fs.mkdir(destination, recursive=true, allow_exist=true)
    File(file) => {
      @fs.mkdir(
        @host_path.Path(destination).dirname().0,
        recursive=true,
        allow_exist=true,
      )
      @fs.write_file(
        destination,
        file.to_bytes(),
        create_mode=CreateNew,
        permission=entry.mode() & 0o777,
      )
    }
  }
}

///|
async fn verify_archive_graph(
  root : String,
  packages : Array[PackagedModule],
) -> Array[String] {
  let stage = @fs.tmpdir(prefix="morphir-release-archives-")
  defer @fs.rmdir(stage, recursive=true)
  for record in packages {
    let bytes = @fs.read_file(join_host(root, record.archive_path)).binary()
    if digest(bytes) != record.evidence.archive_sha256 {
      raise Refusal(
        ArchiveInvalid(
          "Package changed before isolated build: " + record.manifest.name,
        ),
      )
    }
    let directory = join_host(stage, record.manifest.path.0)
    @fs.mkdir(directory, recursive=true, allow_exist=true)
    for entry in @zipc.Archive::from_bytes(bytes).to_array() {
      write_member(directory, entry)
    }
  }
  @fs.write_file(
    join_host(stage, "moon.work"),
    "members = " +
    Json(packages.map(record => record.manifest.path.0)).stringify() +
    "\n",
  )
  let targets = ["wasm", "wasm-gc", "js", "native"]
  for target in targets {
    let (status, stdout, stderr) = @process.collect_output(
      "moon",
      ["-C", stage, "build", "--target", target],
      extra_env={ "MOON_WORK": join_host(stage, "moon.work") },
    )
    @stdio.stderr.write(stdout.text())
    @stdio.stderr.write(stderr.text())
    if status != 0 {
      raise Refusal(
        ArchiveInvalid("Isolated archive graph failed on " + target),
      )
    }
  }
  targets
}

///|
async test "archive verification ignores a hostile ambient workspace override" {
  let root = @fs.tmpdir(prefix="morphir hostile workspace ")
  defer @fs.rmdir(root, recursive=true)
  let files = fixture_archive_files()
  files.push(("answer.mbt", b"pub fn answer() -> Int { 42 }\n"))
  let bytes = fixture_archive(files)
  @fs.write_file(join_host(root, "archive.zip"), bytes)
  let manifest = fixture_manifest("pkgs/core", "finos/morphir-core")
  let record : PackagedModule = {
    manifest,
    archive_path: "archive.zip",
    evidence: inspect_archive(manifest, bytes),
  }
  let previous = @env.get_env_var("MOON_WORK")
  @env.set_env_var("MOON_WORK", join_host(root, "missing/hostile/moon.work"))
  defer (match previous {
    Some(value) => @env.set_env_var("MOON_WORK", value)
    None => @env.unset_env_var("MOON_WORK")
  })
  assert_eq(verify_archive_graph(root, [record]), [
    "wasm", "wasm-gc", "js", "native",
  ])
}

///|
async fn package_sources(root : String, inspection : Inspection) -> PackageSet {
  let commit = require_clean_sources(root, inspection)
  let (compiler, core_pin_sha256) = compiler_for(root, commit)
  let stage = @fs.tmpdir(prefix="morphir-release-sources-")
  defer @fs.rmdir(stage, recursive=true)
  snapshot_public_sources(root, stage, inspection, commit)
  let output = join_host(root, ".dev/mooncakes-release/build/" + commit.0)
  @fs.mkdir(output, recursive=true, allow_exist=true)
  let packages = []
  for index, manifest in inspection.ordered {
    let args = [
      "-C",
      join_host(stage, manifest.path.0),
      "package",
      "--target-dir",
      output,
    ]
    // The first package resolves the isolated public graph. Every subsequent
    // package freezes that same graph instead of resolving dependencies again.
    if index > 0 {
      args.push("--frozen")
    }
    let (status, stdout, stderr) = @process.collect_output("moon", args, extra_env={
      "MOON_WORK": join_host(stage, "moon.work"),
    })
    @stdio.stderr.write(stdout.text())
    @stdio.stderr.write(stderr.text())
    if status != 0 {
      raise Refusal(ArchiveInvalid("Moon packaging failed: " + manifest.name))
    }
    let filename = manifest.name.replace_all(old="/", new="-") +
      "-" +
      manifest.version +
      ".zip"
    let relative = ".dev/mooncakes-release/build/" +
      commit.0 +
      "/publish/" +
      filename
    let evidence = inspect_archive(
      manifest,
      @fs.read_file(join_host(root, relative)).binary(),
    )
    packages.push({ manifest, archive_path: relative, evidence, })
  }
  if require_clean_sources(root, inspection) != commit {
    raise Refusal(CandidateMismatch("Source commit changed during packaging"))
  }
  let isolated_targets = verify_archive_graph(root, packages)
  { commit, compiler, core_pin_sha256, packages, isolated_targets, }
}

///|
fn package_set_json(packages : PackageSet) -> Json {
  {
    "sha": packages.commit.0,
    "compilerVersion": packages.compiler,
    "corePinSha256": packages.core_pin_sha256,
    "isolatedTargets": packages.isolated_targets,
    "modules": packages.packages.map(fn(record : PackagedModule) -> Json {
      {
        "path": record.manifest.path.0,
        "name": record.manifest.name,
        "version": record.manifest.version,
        "archivePath": record.archive_path,
        "archiveSha256": record.evidence.archive_sha256,
        "contentSha256": record.evidence.content_sha256,
        "bytes": record.evidence.bytes,
        "files": record.evidence.files,
      }
    }),
  }
}

///|
fn require_plan(value : Json, inspection : Inspection) -> Candidate raise {
  if string_field(value, "profile") != Some("morphir/mooncakes-plan") ||
    string_field(value, "contractVersion") != Some("0.1.0") {
    raise Refusal(CandidateMismatch("Unknown release plan contract"))
  }
  let mode = match required_string(value, "mode") {
    "publish" => Publish
    "dry-run" => DryRun
    _ => raise Refusal(CandidateMismatch("Invalid release plan mode"))
  }
  Candidate::from_input(
    inspection.version.0,
    required_string(value, "tag"),
    required_string(value, "sha"),
    mode,
  )
}

///|
fn require_package_proof(plan : Json, current : PackageSet) -> Unit raise {
  guard plan is Object(fields) && fields.get("packages") is Some(expected) else {
    raise Refusal(CandidateMismatch("Plan has no package evidence"))
  }
  if expected != package_set_json(current) {
    raise Refusal(
      CandidateMismatch(
        "Candidate package, source or toolchain evidence changed since planning",
      ),
    )
  }
}

///|
async fn write_owned_json(
  file : String,
  value : Json,
  profile : String,
) -> Unit {
  if @fs.exists(file) {
    if @fs.kind(file, follow_symlink=false) != Regular ||
      string_field(@json.parse(@fs.read_file(file).text()), "profile") !=
      Some(profile) {
      raise Refusal(
        CandidateMismatch("Refusing to replace an unrelated result file"),
      )
    }
  }
  let directory = @host_path.Path(file).dirname().0
  @fs.mkdir(directory, recursive=true, allow_exist=true)
  let temporary = file + ".tmp"
  let output = @fs.open(temporary, mode=WriteOnly, create_mode=CreateNew)
  defer output.close()
  errdefer @fs.remove(temporary)
  output.write(value.stringify(indent=2) + "\n")
  output.sync()
  output.close()
  @fs.rename(temporary, file, replace=true)
}

///|
fn release_file(root : String, relative : String) -> String raise {
  let path = ModulePath::parse(relative)
  if !path.0.has_prefix(".dev/mooncakes-release/") {
    raise Refusal(
      CandidateMismatch(
        "Release result files must be inside .dev/mooncakes-release/",
      ),
    )
  }
  join_host(root, path.0)
}

///|
async fn registry_archive(
  manifest : Manifest,
  check~ : RegistryCheck = Resolvable,
) -> RegistryState {
  // The public download origin carries no credentials and redirects are not
  // followed. Hash the actual source archive, not descriptive API metadata.
  @async.with_timeout(20000, () => {
    let (metadata_response, metadata_body) = @http.get(
      "https://mooncakes.io/api/v0/manifest/" +
      manifest.name +
      "@" +
      manifest.version,
    )
    if registry_http_status(Metadata, metadata_response.code) is Some(state) {
      return state
    }
    let metadata = @json.parse(metadata_body.text())
    let expected_checksum = registry_checksum(metadata, manifest)
    let (response, stream) = @http.get_stream(
      "https://download.mooncakes.io/user/" +
      manifest.name +
      "/" +
      manifest.version +
      ".zip",
    )
    defer stream.close()
    match registry_http_status(Archive, response.code) {
      Some(state) => state
      None => {
        let bytes = @buffer.Buffer()
        let mut size = 0
        while stream.read_some(max_len=65536) is Some(chunk) {
          size += chunk.length()
          if size > 64 * 1024 * 1024 {
            return Unavailable
          }
          bytes.write_bytes(chunk)
        }
        let actual = digest(bytes.to_bytes())
        if actual != expected_checksum {
          return Unavailable
        }
        if check is EvidenceOnly {
          return Present(actual)
        }
        let (updated, _, _) = @process.collect_output("moon", ["update"])
        if updated != 0 {
          return Unavailable
        }
        let index = join_host(
          moon_home(),
          "registry/index/user/" + manifest.name + ".index",
        )
        if !@fs.exists(index) {
          return Transient(425)
        }
        let records = @fs.read_file(index).text()
        match index_checksum(records, manifest.version) {
          Some(checksum) if checksum == actual => Present(actual)
          Some(_) => Unavailable
          None => Transient(425)
        }
      }
    }
  }) catch {
    _ => Unavailable
  }
}

///|
enum PreflightDecision {
  Ready
  Refused
}

///|
async fn registry_preflight(root : String, packages : PackageSet) -> Json {
  let rows : Array[Json] = []
  let mut decision = Ready
  let by_name = Map::from_iter(
    packages.packages.iter().map(record => (record.manifest.name, record)),
  )
  for record in packages.packages {
    let observation = poll_registry(
      record.manifest.name,
      false,
      name => registry_archive(by_name[name].manifest, check=EvidenceOnly),
      delay => @async.sleep(delay),
    )
    let state = availability(record.evidence.archive_sha256, observation)
    if state is Conflict || state is Unverified {
      decision = Refused
    }
    rows.push({
      "name": record.manifest.name,
      "version": record.manifest.version,
      "candidateArchiveSha256": record.evidence.archive_sha256,
      "registryArchiveSha256": match observation {
        Present(checksum) => Json(checksum)
        _ => Json::null()
      },
      "state": match state {
        Available => "available"
        Identical => "verified-existing"
        Conflict => "conflict"
        Unverified => "unavailable"
      },
    })
  }
  let report : Json = {
    "profile": "morphir/mooncakes-registry-preflight",
    "contractVersion": "0.1.0",
    "sha": packages.commit.0,
    "compilerVersion": packages.compiler,
    "state": if decision is Ready {
      "ready"
    } else {
      "refused"
    },
    "modules": rows,
  }
  let file = release_file(root, ".dev/mooncakes-release/preflight.json")
  write_owned_json(file, report, "morphir/mooncakes-registry-preflight")
  if decision is Refused {
    raise Refusal(
      CandidateMismatch(
        "Registry version availability is conflicting or unverified; inspect " +
        file,
      ),
    )
  }
  report
}

///|
fn moon_home() -> String raise {
  match @env.get_env_var("MOON_HOME") {
    Some(home) if !home.is_empty() => home
    _ =>
      match @env.get_env_var("HOME") {
        Some(home) if !home.is_empty() => join_host(home, ".moon")
        _ => raise Refusal(CandidateMismatch("Active Moon home is unavailable"))
      }
  }
}

///|
fn registry_checksum(metadata : Json, manifest : Manifest) -> String raise {
  guard metadata is Object(fields) &&
    fields.get("metadata") is Some(nested) &&
    string_field(metadata, "module") == Some(manifest.name) &&
    string_field(metadata, "version") == Some(manifest.version) &&
    fields.get("yanked") == Some(Json(false)) &&
    string_field(nested, "name") == Some(manifest.name) &&
    string_field(nested, "version") == Some(manifest.version) &&
    string_field(nested, "checksum") is Some(checksum) &&
    checksum.length() == 64 &&
    checksum.iter().all(c => (c >= '0' && c <= '9') || (c >= 'a' && c <= 'f')) else {
    raise Refusal(
      CandidateMismatch(
        "Registry metadata does not prove the expected public identity and checksum",
      ),
    )
  }
  checksum
}

///|
fn index_checksum(records : String, version : String) -> String? raise {
  let mut found = None
  for line in records.split("\n") {
    if line.trim().is_empty() {
      continue
    }
    let record = @json.parse(line)
    if string_field(record, "version") == Some(version) {
      guard record is Object(fields) else { return None }
      found = if fields.get("yanked") == Some(Json(true)) {
        None
      } else {
        string_field(record, "checksum")
      }
    }
  }
  found
}

///|
fn publication_json(
  candidate : Candidate,
  packages : PackageSet,
  outcomes : Array[Publication],
) -> Json {
  {
    "profile": "morphir/mooncakes-publication",
    "contractVersion": "0.1.0",
    "sha": candidate.commit.0,
    "tag": "v" + candidate.version.0,
    "version": candidate.version.0,
    "packages": package_set_json(packages),
    "modules": outcomes.map(fn(outcome : Publication) -> Json {
      let fields : Map[String, Json] = { "name": outcome.name }
      fields["state"] = match outcome.state {
        Published => "published"
        VerifiedExisting => "verified-existing"
        Failed(message) => {
          fields["message"] = Json(message)
          "failed"
        }
        NotAttempted => "not-attempted"
      }
      Json(fields)
    }),
  }
}

///|
async fn publish_candidate(
  root : String,
  inspection : Inspection,
  plan : Json,
  report_file : String,
) -> Json {
  let candidate = require_plan(plan, inspection)
  if candidate.mode is DryRun {
    raise Refusal(CandidateMismatch("A dry-run plan cannot publish"))
  }
  if (
      @env.get_env_var("MOONCAKES_REGISTRY") is Some(registry_override) &&
      !registry_override.is_empty()
    ) ||
    @fs.exists(join_host(moon_home(), "config.json")) {
    raise Refusal(
      CandidateMismatch(
        "Publication requires the default registry without a Moon home config.json or MOONCAKES_REGISTRY override",
      ),
    )
  }
  if @env.get_env_var("GITHUB_ACTIONS") != Some("true") ||
    @env.get_env_var("GITHUB_REPOSITORY") != Some("finos/morphir-moonbit") ||
    @env.get_env_var("GITHUB_REF") != Some("refs/tags/v" + candidate.version.0) ||
    @env.get_env_var("GITHUB_SHA") != Some(candidate.commit.0) {
    raise Refusal(
      CandidateMismatch(
        "Publication requires the qualified repository workflow running on this exact release tag and SHA",
      ),
    )
  }
  if !child("git", [
      "-C", root, "status", "--porcelain=v1", "--untracked-files=normal",
    ]).is_empty() {
    raise Refusal(CandidateMismatch("Candidate checkout must be clean"))
  }
  ignore(
    child("git", [
      "-C",
      root,
      "merge-base",
      "--is-ancestor",
      candidate.commit.0,
      "origin/main",
    ]),
  )
  let packages = package_sources(root, inspection)
  require_package_proof(plan, packages)
  let stage = @fs.tmpdir(prefix="morphir-release-publish-")
  defer @fs.rmdir(stage, recursive=true)
  snapshot_public_sources(root, stage, inspection, candidate.commit)
  let by_name = Map::from_iter(
    packages.packages.iter().map(record => (record.manifest.name, record)),
  )
  let outcomes = publish_sequence(
    candidate.mode,
    packages.packages.map(record => {
      (record.manifest.name, record.evidence.archive_sha256)
    }),
    name => registry_archive(by_name[name].manifest),
    name => {
      // Do not emit Mooncake output: publishing failures may include credential
      // or HTTP diagnostics. The bounded report retains only the exit status.
      try {
        let (code, _, _) = @process.collect_output(
          "moon",
          ["-C", join_host(stage, by_name[name].manifest.path.0), "publish"],
          extra_env={ "MOON_WORK": join_host(stage, "moon.work") },
        )
        code
      } catch {
        _ => 1
      }
    },
    states => {
      write_owned_json(
        report_file,
        publication_json(candidate, packages, states),
        "morphir/mooncakes-publication",
      )
    },
    delay => @async.sleep(delay),
  )
  if outcomes.any(outcome => outcome.state is Failed(_)) {
    raise Refusal(
      CandidateMismatch(
        "Publication stopped; inspect the partial report at " + report_file,
      ),
    )
  }
  publication_json(candidate, packages, outcomes)
}

///|
let consumer_source : String =
  #|fn main raise {
  #|  let runtime = @scheme.Runtime::new()
  #|  assert_eq(@scheme.value_preview(runtime.eval("(+ 20 22)"), 64), "42")
  #|  let decimal = "12345678901234567890123456789012345678901234567890"
  #|  assert_eq(@bigint.BigInt::from_string(decimal).to_string(), decimal)
  #|  assert_eq(@scheme.value_preview(runtime.eval(decimal), 128), decimal)
  #|  println("morphir-registry-consumer-ok")
  #|}
  #|

///|
fn consumer_manifest(inspection : Inspection) -> String {
  "name = \"morphir-release/consumer\"\nversion = \"0.0.0\"\nimport {\n" +
  inspection.ordered
  .map(manifest => {
    "  " + Json(manifest.name + "@" + inspection.version.0).stringify() + ",\n"
  })
  .join("") +
  "}\n"
}

///|
test "consumer requests every public version without local path substitutions" {
  let version = ReleaseVersion::parse("0.1.0")
  let ordered = [
    fixture_manifest("pkgs/scheme", "finos/morphir-scheme"),
    fixture_manifest("apps/morphir", "finos/morphir"),
  ]
  let inspection : Inspection = { version, ordered, inventory: [], }
  let manifest = decode_manifest(
    ModulePath::parse("consumer"),
    consumer_manifest(inspection),
  )
  assert_eq(manifest.dependencies, {
    "finos/morphir-scheme": "0.1.0",
    "finos/morphir": "0.1.0",
  })
  assert_false(consumer_manifest(inspection).contains("path"))
  let correct : Json = {
    "profile": "morphir/command-result",
    "contractVersion": "0.1.0",
    "command": "version",
    "state": "succeeded",
    "exitCode": 0,
    "diagnostics": [],
    "result": { "name": "finos/morphir", "version": "0.1.0" },
  }
  require_cli_version(correct.stringify(), version)
  for
    invalid in [
      "{}",
      "not JSON",
      correct.stringify().replace_all(old="0.1.0", new="0.2.0"),
    ] {
    let refused = try {
      require_cli_version(invalid, version)
      false
    } catch {
      _ => true
    }
    assert_true(refused)
  }
}

///|
async fn consumer_child(
  program : String,
  args : Array[String],
  stage : String,
  environment : Map[String, String],
) -> String {
  let (code, output, stderr) = @process.collect_output(
    program,
    args,
    cwd=stage,
    extra_env=environment,
  )
  @stdio.stderr.write(stderr.text())
  if code != 0 {
    raise Refusal(
      CandidateMismatch(
        "Clean registry consumer failed: " +
        program +
        " with status " +
        code.to_string(),
      ),
    )
  }
  output.text()
}

///|
fn require_cli_version(text : String, version : ReleaseVersion) -> Unit raise {
  guard @json.parse(text) is Object(fields) &&
    fields.get("profile") == Some(Json("morphir/command-result")) &&
    fields.get("contractVersion") == Some(Json("0.1.0")) &&
    fields.get("command") == Some(Json("version")) &&
    fields.get("state") == Some(Json("succeeded")) &&
    fields.get("exitCode") == Some(Json(0)) &&
    fields.get("result") is Some(result) &&
    string_field(result, "name") == Some("finos/morphir") &&
    string_field(result, "version") == Some(version.0) else {
    raise Refusal(
      CandidateMismatch("Published CLI version differs from candidate"),
    )
  }
}

///|
async fn verify_consumer(
  root : String,
  inspection : Inspection,
  version : ReleaseVersion,
) -> Json {
  if version != inspection.version {
    raise Refusal(
      CandidateMismatch(
        "Verification version must match the checked-out release inventory",
      ),
    )
  }
  let commit = CommitId::parse(
    child("git", ["-C", root, "rev-parse", "HEAD"]).trim().to_owned(),
  )
  let (compiler, core_pin_sha256) = compiler_for(root, commit)
  if (
      @env.get_env_var("MOONCAKES_REGISTRY") is Some(value) && !value.is_empty()
    ) ||
    @fs.exists(join_host(moon_home(), "config.json")) {
    raise Refusal(
      CandidateMismatch(
        "Consumer verification requires the default Mooncakes registry",
      ),
    )
  }
  let stage = @fs.tmpdir(prefix="morphir-registry-consumer-")
  defer @fs.rmdir(stage, recursive=true)
  let environment : Map[String, String] = {
    "MOON_WORK": join_host(stage, "moon.work"),
    "MOON_DEP_CACHE": join_host(stage, "dependency-cache"),
    "MOON_BUILD_CACHE": join_host(stage, "build-cache"),
    "MOONCAKES_TOKEN": "",
  }
  @fs.write_file(join_host(stage, "moon.work"), "members = [\".\"]\n")
  @fs.write_file(join_host(stage, "moon.mod"), consumer_manifest(inspection))
  @fs.write_file(
    join_host(stage, "moon.pkg"),
    "pkgtype(kind: \"executable\")\nimport {\n  \"finos/morphir-scheme\" @scheme,\n  \"moonbitlang/core/bigint\",\n}\n",
  )
  @fs.write_file(join_host(stage, "main.mbt"), consumer_source)
  let targets = ["wasm", "wasm-gc", "js", "native"]
  for target in targets {
    let output = consumer_child(
      "moon",
      ["run", ".", "--target", target],
      stage,
      environment,
    )
    if output.trim() != "morphir-registry-consumer-ok" {
      raise Refusal(
        CandidateMismatch(
          "Registry library consumer did not finish its Scheme and stock-core decimal checks",
        ),
      )
    }
  }
  let resolved : Array[Json] = []
  for manifest in inspection.ordered {
    let path = join_host(stage, ".mooncakes/" + manifest.name + "/moon.mod")
    let actual = decode_manifest(manifest.path, @fs.read_file(path).text())
    if actual.name != manifest.name || actual.version != version.0 {
      raise Refusal(
        CandidateMismatch(
          "Consumer resolved an unexpected module identity: " + manifest.name,
        ),
      )
    }
    resolved.push({ "name": actual.name, "version": actual.version })
  }
  let coordinate = "finos/morphir@" + version.0
  // Registry executable builds materialize their own module outside this
  // consumer. They must not inherit its pinned workspace.
  let executable_environment = environment.copy()
  executable_environment["MOON_WORK"] = "off"
  let help = consumer_child(
    "moonx",
    [coordinate, "--help"],
    stage,
    executable_environment,
  )
  if !help.contains("Usage: morphir") {
    raise Refusal(CandidateMismatch("Published moonx CLI help is unavailable"))
  }
  require_cli_version(
    consumer_child(
      "moonx",
      [coordinate, "version", "--json"],
      stage,
      executable_environment,
    ),
    version,
  )
  let binaries = join_host(stage, "bin")
  ignore(
    consumer_child(
      "moon",
      ["install", coordinate, "--bin", binaries],
      stage,
      executable_environment,
    ),
  )
  let executable = if @fs.exists(join_host(binaries, "morphir")) {
    join_host(binaries, "morphir")
  } else {
    join_host(binaries, "morphir.exe")
  }
  let installed_help = consumer_child(
    executable,
    ["--help"],
    stage,
    executable_environment,
  )
  if !installed_help.contains("Usage: morphir") {
    raise Refusal(CandidateMismatch("Installed native CLI help is unavailable"))
  }
  require_cli_version(
    consumer_child(
      executable,
      ["version", "--json"],
      stage,
      executable_environment,
    ),
    version,
  )
  let worksheet = join_host(stage, "answer.scm")
  @fs.write_file(worksheet, "(+ 40 2)")
  let answer = @json.parse(
    consumer_child(
      executable,
      ["worksheet", worksheet, "--json"],
      stage,
      executable_environment,
    ),
  )
  guard answer is Object(fields) &&
    fields.get("observations") is Some(Array(rows)) &&
    rows.length() == 1 &&
    string_field(rows[0], "preview") == Some("42") &&
    fields.get("completion") is Some(completion) &&
    string_field(completion, "status") == Some("returned") else {
    raise Refusal(
      CandidateMismatch("Installed native CLI worksheet did not return 42"),
    )
  }
  {
    "profile": "morphir/mooncakes-consumer",
    "contractVersion": "0.1.0",
    "sha": commit.0,
    "version": version.0,
    "compilerVersion": compiler,
    "corePinSha256": core_pin_sha256,
    "modules": resolved,
    "libraryTargets": targets,
    "stockCoreLongDecimal": "passed",
    "moonxHelp": "passed",
    "moonxVersion": "passed",
    "nativeHelp": "passed",
    "nativeVersion": "passed",
    "nativeWorksheet": "42",
    "dependencyCache": "fresh",
    "localWorkspaceInputs": false,
  }
}

///|
async fn discovered_modules(root : String) -> Array[ModulePath] {
  // Include new unignored manifests as well as tracked source. Git excludes
  // build caches and installed dependencies from the source-module inventory.
  let output = child("git", [
    "-C", root, "ls-files", "-z", "--cached", "--others", "--exclude-standard",
  ])
  let paths = []
  for file in output.split("\u{0}") {
    if file == "moon.mod" {
      paths.push(ModulePath::parse("."))
    } else if file.has_suffix("/moon.mod") {
      paths.push(
        ModulePath::parse(
          file[:file.length() - "/moon.mod".length()].to_owned(),
        ),
      )
    } else if file == "moon.mod.json" || file.has_suffix("/moon.mod.json") {
      raise Refusal(
        ManifestSyntax(
          "Migrate legacy module manifest before release: " + file.to_owned(),
        ),
      )
    }
  }
  paths.sort_by((left, right) => left.0.lexical_compare(right.0))
  paths
}

///|
async fn confined_file(
  directory : String,
  relative : String,
  problem : Problem,
) -> Unit {
  let ModulePath(path) = ModulePath::parse(relative)
  if !@fs.exists(join_host(directory, path)) {
    raise Refusal(problem)
  }
  let canonical = @fs.realpath(join_host(directory, path))
  if !is_within(directory, canonical) {
    raise Refusal(InvalidPath(relative))
  }
  guard @fs.kind(canonical) is Regular else { raise Refusal(problem) }
}

///|
async fn inspect(root : String) -> Inspection {
  let root = @fs.realpath(root)
  let inventory = decode_inventory(
    @json.parse(
      @fs.read_file(join_host(root, "scripts/mooncakes-modules.json")).text(),
    ),
  )
  let discovered = discovered_modules(root)
  let manifests = []
  for path in discovered {
    let directory = @fs.realpath(join_host(root, path.0))
    if !is_within(root, directory) {
      raise Refusal(InvalidPath(path.0))
    }
    confined_file(directory, "moon.mod", MissingModule(path.0))
    manifests.push(
      decode_manifest(
        path,
        @fs.read_file(join_host(directory, "moon.mod")).text(),
      ),
    )
  }
  guard inventory.iter().filter(entry => entry.disposition is Public).next()
    is Some(first) &&
    manifests.iter().filter(manifest => manifest.path == first.path).next()
    is Some(first_manifest) else {
    raise Refusal(InvalidInventory("No public module manifest"))
  }
  let version = ReleaseVersion::parse(first_manifest.version)
  let ordered = publish_order(inventory, manifests, discovered, version)
  for manifest in ordered {
    let directory = @fs.realpath(join_host(root, manifest.path.0))
    confined_file(
      directory,
      manifest.readme.unwrap(),
      MissingReadme(manifest.name),
    )
    confined_file(directory, "LICENSE", MissingLicense(manifest.name))
    if manifest.name == "finos/morphir" {
      confined_file(
        directory,
        "cli/release_identity.mbt",
        MissingModule("CLI generated identity"),
      )
      require_identity(
        manifest,
        @fs.read_file(join_host(directory, "cli/release_identity.mbt")).text(),
      )
    }
  }
  { inventory, ordered, version, }
}

///|
fn is_within(directory : String, target : String) -> Bool {
  let relative = @host_path.Path(target).relative(
    base=@host_path.Path(directory),
  )
  !relative.is_absolute() &&
  relative.0 != ".." &&
  !relative.0.has_prefix(".." + @host_path.sep.to_string())
}

///|
fn join_host(directory : String, relative : String) -> String {
  @host_path.Path(directory).join(@host_path.Path(relative)).0
}

///|
test "host path confinement respects directory boundaries" {
  let root = @host_path.Path("release-root").resolve().0
  assert_true(is_within(root, join_host(root, "pkgs/core/README.md")))
  assert_true(is_within(root, root))
  assert_false(is_within(root, join_host(root, "../outside")))
  assert_false(is_within(root, root + "-sibling"))
}

///|
fn command(name : String) -> @argparse.Command {
  let options = if name == "plan" {
    [
      @argparse.OptionArg("tag"),
      @argparse.OptionArg("sha"),
      @argparse.OptionArg("mode"),
      @argparse.OptionArg("output", default_values=[
        ".dev/mooncakes-release/plan.json",
      ]),
    ]
  } else if name == "publish" {
    [
      @argparse.OptionArg("plan", default_values=[
        ".dev/mooncakes-release/plan.json",
      ]),
      @argparse.OptionArg("report", default_values=[
        ".dev/mooncakes-release/publication.json",
      ]),
    ]
  } else if name == "verify" {
    [
      @argparse.OptionArg("output", default_values=[
        ".dev/mooncakes-release/consumer.json",
      ]),
    ]
  } else if name == "workflow" {
    [@argparse.OptionArg("mode")]
  } else if name == "gate-ci" {
    [
      @argparse.OptionArg("sha"),
      @argparse.OptionArg("output", default_values=[
        ".dev/mooncakes-release/ci-gate.json",
      ]),
    ]
  } else if name == "gate-qualification" {
    [
      @argparse.OptionArg("sha"),
      @argparse.OptionArg("output", default_values=[
        ".dev/mooncakes-release/qualification-gate.json",
      ]),
      @argparse.OptionArg("receipt", default_values=[
        ".dev/qualification-receipt/receipt.ionb",
      ]),
    ]
  } else {
    []
  }
  // The parsing library owns required inputs and help's alternative. There is
  // no second scanner that guesses whether required options can be skipped.
  let groups = if name == "plan" {
    ["tag", "sha", "mode"].map(name => {
      @argparse.ArgGroup(name + "-or-help", required=true, multiple=true, args=[
        name, "help",
      ])
    })
  } else if name == "verify" {
    [
      @argparse.ArgGroup("version-or-help", required=true, multiple=true, args=[
        "version", "help",
      ]),
    ]
  } else if name == "workflow" ||
    name == "gate-ci" ||
    name == "gate-qualification" {
    let option = if name == "workflow" { "mode" } else { "sha" }
    [
      @argparse.ArgGroup(option + "-or-help", required=true, multiple=true, args=[
        option, "help",
      ]),
    ]
  } else {
    []
  }
  @argparse.Command(
    name,
    flags=[@argparse.FlagArg("help", short='h', global=true)] +
      (if name == "workflow" {
        [@argparse.FlagArg("github-output")]
      } else {
        []
      }),
    options~,
    groups~,
    positionals=if name == "verify" {
      [@argparse.PositionArg("version", num_args=@argparse.ValueRange(upper=1))]
    } else {
      []
    },
    disable_help_flag=true,
    disable_help_subcommand=true,
    disable_version_flag=true,
  )
}

///|
fn cli() -> @argparse.Command {
  @argparse.Command(
    "mooncakes-release.mbtx",
    disable_help_flag=true,
    disable_help_subcommand=true,
    disable_version_flag=true,
    about="Check public Mooncakes packages, plan a fixed candidate, or publish a qualified tag candidate in dependency order. Workflow validates actual GitHub event/ref/SHA and optionally writes --github-output. Gate-ci requires successful exact main-push CI and ci-ok, polling at most 20 minutes. Gate-qualification checks --receipt Ion against --sha, the current workflow run/attempt, v2 profile, macos:run and every required job. Gate commands emit version 0.1.0 morphir/mooncakes-ci-gate or morphir/mooncakes-qualification-gate evidence. Unavailable, skipped, cancelled, failed or stale evidence refuses publication. Check and plan never read credentials or upload. Identity regenerates the tracked apps/morphir/cli/release_identity.mbt after a version change; check refuses stale identity. Verify takes X.Y.Z and resolves every public version with fresh dependency/build caches outside any repository workspace, then exercises Scheme and long-decimal parsing on four targets, moonx help/version and an installed native CLI worksheet. Consumer results use morphir/mooncakes-consumer 0.1.0. Publication and consumer hosts are qualified on Linux. They require the default registry without Moon home config.json or MOONCAKES_REGISTRY overrides. Plan writes --output, default .dev/mooncakes-release/plan.json. Publish consumes --plan and persists --report after each module. Result files must be under .dev/mooncakes-release/. Dry-run plans cannot publish. Existing versions require a downloaded archive SHA-256 equal to the planned candidate. Only read-only transient/index visibility checks retry, at most six reads and 31 seconds of backoff per poll. Upload errors stop without retrying. --json emits one morphir/command-result 0.1.0 document on stdout; progress and child diagnostics use stderr. Success has state=succeeded, exitCode=0, diagnostics and result; failure has state=failed, exitCode and error{code,message}. Partial publication outcomes remain in the report on failure. Help returns result.help without file or subprocess effects. Exit 2 is argument syntax; exit 1 is validation/child failure. Check gives inventory and package/toolchain evidence; plan adds tag, commit and mode. Publication records published, verified-existing, failed and not-attempted modules.",
    flags=[
      @argparse.FlagArg("json", global=true),
      @argparse.FlagArg("help", short='h', global=true),
    ],
    options=[@argparse.OptionArg("root", global=true, default_values=["."])],
    subcommands=[
      command("check"),
      command("inventory"),
      command("plan"),
      command("publish"),
      command("identity"),
      command("verify"),
      command("workflow"),
      command("gate-ci"),
      command("gate-qualification"),
      command("gate-needs"),
    ],
  )
}

///|
fn wants_json(argv : Array[String]) -> Bool {
  let probe = @argparse.Command(
    "presentation",
    disable_help_flag=true,
    disable_help_subcommand=true,
    flags=[@argparse.FlagArg("json")],
    positionals=[
      @argparse.PositionArg(
        "opaque",
        allow_hyphen_values=true,
        num_args=@argparse.ValueRange(lower=0),
      ),
    ],
  )
  let parsed = probe.parse(argv~, env=Map([])) catch { _ => return false }
  parsed.flags.get_or_default("json", false)
}

///|
fn inspection_json(inspection : Inspection) -> Json {
  {
    "version": inspection.version.0,
    "publicModules": inspection.ordered.length(),
    "excludedModules": inspection.inventory.length() -
    inspection.ordered.length(),
    "order": inspection.ordered.map(manifest => Json(manifest.name)),
  }
}

///|
async fn emit(
  name : String,
  json_mode : Bool,
  code : Int32,
  result : Json,
  error? : String,
) -> Unit {
  let output : Json = match error {
    Some(message) =>
      {
        "profile": "morphir/command-result",
        "contractVersion": "0.1.0",
        "command": "release." + name,
        "state": "failed",
        "exitCode": code,
        "error": {
          "code": if code == 2 {
            "invalid_arguments"
          } else {
            "release_refused"
          },
          "message": message,
        },
        "diagnostics": [],
      }
    None =>
      {
        "profile": "morphir/command-result",
        "contractVersion": "0.1.0",
        "command": "release." + name,
        "state": "succeeded",
        "exitCode": 0,
        "result": result,
        "diagnostics": [],
      }
  }
  if json_mode {
    @stdio.stdout.write(output.stringify() + "\n")
  } else if error is Some(message) {
    @stdio.stderr.write(message + "\n")
  } else if string_field(result, "help") is Some(help) {
    @stdio.stdout.write(help + "\n")
  } else {
    @stdio.stdout.write(result.stringify(indent=2) + "\n")
  }
  if code != 0 {
    @sys.exit(code)
  }
}

///|
async fn main {
  let argv = @env.args()[1:].to_owned()
  let json_mode = wants_json(argv)
  let parsed = cli().parse(argv~, env=Map([])) catch {
    error => {
      emit("mooncakes", json_mode, 2, Json::null(), error=error.to_string())
      return
    }
  }
  let (name, args) = parsed.subcommand.unwrap_or(("check", parsed))
  let help = args.flags.get_or_default("help", false) ||
    parsed.flags.get_or_default("help", false)
  if help || parsed.subcommand is None {
    emit(name, json_mode, 0, {
      "help": if parsed.subcommand is None {
        cli().render_help()
      } else {
        command(name).render_help()
      },
    })
    return
  }
  let result : Json = try {
    let root_input = parsed.values.get("root").unwrap_or(["."])[0]
    if root_input.is_empty() {
      raise Refusal(InvalidPath("Root must be nonempty"))
    }
    let root = @fs.realpath(root_input)
    if name == "identity" {
      let directory = join_host(root, "apps/morphir")
      let manifest = decode_manifest(
        ModulePath::parse("apps/morphir"),
        @fs.read_file(join_host(directory, "moon.mod")).text(),
      )
      @fs.write_file(
        join_host(directory, "cli/release_identity.mbt"),
        identity_source(manifest),
      )
      emit(name, json_mode, 0, {
        "path": "apps/morphir/cli/release_identity.mbt",
        "name": manifest.name,
        "version": manifest.version,
      })
      return
    }
    let inspection = inspect(root)
    if name == "inventory" {
      inspection_json(inspection)
    } else if name == "workflow" {
      workflow_candidate(
        root,
        inspection,
        ReleaseMode::parse(args.values["mode"][0]),
        args.flags.get_or_default("github-output", false),
      )
    } else if name == "gate-needs" {
      require_release_needs(
        @json.parse(@env.get_env_var("RELEASE_NEEDS").unwrap_or("null")),
      )
      {
        "prerequisites": ["plan", "ci", "qualification", "headless"],
        "state": "succeeded",
      }
    } else if name == "gate-ci" {
      let file = release_file(root, args.values["output"][0])
      let evidence = gate_ci(CommitId::parse(args.values["sha"][0]))
      write_owned_json(file, evidence, "morphir/mooncakes-ci-gate")
      evidence
    } else if name == "gate-qualification" {
      let file = release_file(root, args.values["output"][0])
      let evidence = gate_qualification(
        root,
        args.values["receipt"][0],
        CommitId::parse(args.values["sha"][0]),
      )
      write_owned_json(file, evidence, "morphir/mooncakes-qualification-gate")
      evidence
    } else if name == "check" {
      {
        "inventory": inspection_json(inspection),
        "packages": package_set_json(package_sources(root, inspection)),
      }
    } else if name == "verify" {
      let file = release_file(root, args.values["output"][0])
      let receipt = verify_consumer(
        root,
        inspection,
        ReleaseVersion::parse(args.values["version"][0]),
      )
      write_owned_json(file, receipt, "morphir/mooncakes-consumer")
      receipt
    } else if name == "publish" {
      let plan_file = release_file(root, args.values["plan"][0])
      let report_file = release_file(root, args.values["report"][0])
      if plan_file == report_file {
        raise Refusal(
          CandidateMismatch(
            "Plan and publication report must use different files",
          ),
        )
      }
      publish_candidate(
        root,
        inspection,
        @json.parse(@fs.read_file(plan_file).text()),
        report_file,
      )
    } else {
      let mode = match args.values["mode"][0] {
        "dry-run" => DryRun
        "publish" => Publish
        text =>
          raise Refusal(
            InvalidInventory("Mode must be dry-run or publish: " + text),
          )
      }
      let candidate = Candidate::from_input(
        inspection.version.0,
        args.values["tag"][0],
        args.values["sha"][0],
        mode,
      )
      let actual = child("git", ["-C", root, "rev-parse", "HEAD"])
        .trim()
        .to_owned()
      if actual != candidate.commit.0 {
        raise Refusal(CandidateMismatch("Checkout HEAD differs from --sha"))
      }
      if !child("git", [
          "-C", root, "status", "--porcelain=v1", "--untracked-files=normal",
        ]).is_empty() {
        raise Refusal(CandidateMismatch("Candidate checkout must be clean"))
      }
      let packaged = package_sources(root, inspection)
      if packaged.commit != candidate.commit {
        raise Refusal(
          CandidateMismatch("Packaged commit differs from candidate"),
        )
      }
      let preflight = registry_preflight(root, packaged)
      let plan : Json = {
        "profile": "morphir/mooncakes-plan",
        "contractVersion": "0.1.0",
        "tag": "v" + candidate.version.0,
        "sha": candidate.commit.0,
        "mode": if candidate.mode is DryRun {
          "dry-run"
        } else {
          "publish"
        },
        "inventory": inspection_json(inspection),
        "packages": package_set_json(packaged),
        "registryPreflight": preflight,
      }
      write_owned_json(
        release_file(root, args.values["output"][0]),
        plan,
        "morphir/mooncakes-plan",
      )
      plan
    }
  } catch {
    error => {
      emit(name, json_mode, 1, Json::null(), error=error.to_string())
      return
    }
  }
  emit(name, json_mode, 0, result)
}

///|
test "argument library owns required plan inputs and global JSON help" {
  for
    argv in [
      ["--json", "plan", "--help"],
      ["plan", "--json", "--help"],
      ["--help", "plan", "--json"],
      ["check", "--help", "--json"],
    ] {
    let parsed = cli().parse(argv~, env=Map([]))
    assert_true(parsed.flags.get_or_default("json", false))
  }
  let invalid = try {
    ignore(cli().parse(argv=["plan", "--tag", "v0.1.0"], env=Map([])))
    false
  } catch {
    _ => true
  }
  assert_true(invalid)
  assert_true(wants_json(["check", "--unknown", "--json"]))
  assert_false(wants_json(["--", "--json"]))
  assert_false(wants_json(["--root=--json"]))
}

///|
test "official manifest parser retains pins and rejects invalid configuration" {
  let parsed = decode_manifest(
    ModulePath::parse("pkgs/core"),
    (
      #|name = "finos/morphir-core"
      #|version = "0.1.0"
      #|readme = "README.md"
      #|license = "Apache-2.0"
      #|import { "moonbitlang/x@0.5.5" }
    ),
  )
  assert_eq(parsed.dependencies, { "moonbitlang/x": "0.5.5" })
  assert_eq(parsed.visibility, Open)
  let broken = refused(fn() raise Refusal {
    ignore(decode_manifest(ModulePath("pkgs/core"), "name = \"unterminated"))
  })
  assert_true(broken is Some(ManifestSyntax(_)))
  let entry = fixture_entry("pkgs/core", "finos/morphir-core")
  for
    (manifest, expected) in [
      (
        fixture_manifest("pkgs/core", "finos/morphir-core", license=None),
        MissingLicense("finos/morphir-core"),
      ),
      (
        fixture_manifest("pkgs/core", "finos/morphir-core", visibility=Private),
        PrivateModule("finos/morphir-core"),
      ),
    ] {
    assert_eq(
      refused(fn() raise Refusal {
        ignore(
          publish_order(
            [entry],
            [manifest],
            [entry.path],
            ReleaseVersion("0.1.0"),
          ),
        )
      }),
      Some(expected),
    )
  }
}

///|
async fn fixture_repository(root : String) -> Unit {
  ignore(child("git", ["init", "--quiet", root]))
  @fs.mkdir(root + "/scripts", recursive=true)
  @fs.mkdir(root + "/pkgs/core", recursive=true)
  let inventory : Json = {
    "profile": "morphir/mooncakes-inventory",
    "contractVersion": "0.1.0",
    "modules": [
      {
        "path": "pkgs/core",
        "name": "finos/morphir-core",
        "disposition": "public",
        "reason": "Test public module",
      },
    ],
  }
  @fs.write_file(
    join_host(root, "scripts/mooncakes-modules.json"),
    inventory.stringify(),
  )
  @fs.write_file(
    root + "/pkgs/core/moon.mod",
    (
      #|name = "finos/morphir-core"
      #|version = "0.1.0"
      #|readme = "README.md"
      #|license = "Apache-2.0"
    ),
  )
  @fs.write_file(root + "/pkgs/core/LICENSE", "Test fixture license")
}

///|
async test "source inspection includes new manifests and verifies declared files" {
  let root = @fs.tmpdir(prefix="morphir release source ")
  defer @fs.rmdir(root, recursive=true)
  fixture_repository(root)
  let absent = try {
    ignore(inspect(root))
    None
  } catch {
    Refusal(problem) => Some(problem)
    error => raise error
  }
  assert_eq(absent, Some(MissingReadme("finos/morphir-core")))
  @fs.write_file(root + "/pkgs/core/README.md", "Core fixture")
  assert_eq(inspect(root).ordered.map(manifest => manifest.name), [
    "finos/morphir-core",
  ])
  @fs.mkdir(root + "/new")
  @fs.write_file(root + "/new/moon.mod", "name = \"finos/morphir-new\"")
  let changed = try {
    ignore(inspect(root))
    None
  } catch {
    Refusal(problem) => Some(problem)
    error => raise error
  }
  assert_eq(changed, Some(UnclassifiedModule("new")))
}

///|
async test "command JSON help and syntax errors stay parseable without repository effects" {
  let script = @fs.realpath("mooncakes-release.mbtx")
  for
    (args, expected, state) in [
      (["--json", "--help"], 0, "succeeded"),
      (["plan", "--help", "--json"], 0, "succeeded"),
      (["--help", "plan", "--json"], 0, "succeeded"),
      (["verify", "--help", "--json"], 0, "succeeded"),
      (["publish", "--help", "--json"], 0, "succeeded"),
      (["inventory", "--help", "--json"], 0, "succeeded"),
      (["identity", "--help", "--json"], 0, "succeeded"),
      (["workflow", "--help", "--json"], 0, "succeeded"),
      (["gate-ci", "--help", "--json"], 0, "succeeded"),
      (["gate-qualification", "--help", "--json"], 0, "succeeded"),
      (["gate-needs", "--help", "--json"], 0, "succeeded"),
      (["plan", "--json"], 2, "failed"),
      (["verify", "--json"], 2, "failed"),
      (["workflow", "--json"], 2, "failed"),
      (["gate-ci", "--json"], 2, "failed"),
      (["gate-qualification", "--json"], 2, "failed"),
      (["check", "--unknown", "--json"], 2, "failed"),
      (["--unknown", "--json"], 2, "failed"),
    ] {
    let (code, output, stderr) = @process.collect_output(
      "moonx",
      [script, ..args],
    )
    assert_eq(code, expected, msg=stderr.text())
    let result = @json.parse(output.text())
    assert_eq(string_field(result, "state"), Some(state))
    assert_false(output.text().contains("Downloading"))
  }
}

///|
fn fixture_archive(
  files : Array[(String, Bytes)],
  mtime~ : Int32 = 0,
) -> Bytes raise {
  let archive = @zipc.Archive::empty()
  for (path, data) in files {
    ignore(
      archive.add(
        @zipc.Member::make(
          path,
          File(@zipc.File::stored_from_bytes(data)),
          mtime~,
        ),
      ),
    )
  }
  archive.to_bytes()
}

///|
fn fixture_archive_files() -> Array[(String, Bytes)] {
  [
    (
      "moon.mod",
      @utf8.encode(
        "name = \"finos/morphir-core\"\nversion = \"0.1.0\"\nreadme = \"README.md\"\nlicense = \"Apache-2.0\"",
      ),
    ),
    ("LICENSE", b"Fixture license"),
    ("README.md", b"Core fixture"),
    ("moon.pkg", b"options(\"native-stub\": [\"native.c\"] )"),
    ("native.c", b"/* Fixture native asset */"),
  ]
}

///|
test "archive content proof ignores timestamps and detects changed source bytes" {
  let manifest = fixture_manifest("pkgs/core", "finos/morphir-core")
  let files = fixture_archive_files()
  let first = inspect_archive(
    manifest,
    fixture_archive(files, mtime=@zipc.dos_epoch),
  )
  let second = inspect_archive(
    manifest,
    fixture_archive(files.rev(), mtime=@zipc.dos_epoch + 1000),
  )
  assert_eq(first.content_sha256, second.content_sha256)
  assert_true(first.archive_sha256 != second.archive_sha256)
  assert_eq(first.files, 5)
  assert_true(first.bytes > 0)
  let changed = files.map(entry => {
    if entry.0 == "native.c" {
      (entry.0, b"/* Changed */")
    } else {
      entry
    }
  })
  assert_true(
    inspect_archive(manifest, fixture_archive(changed)).content_sha256 !=
    first.content_sha256,
  )
}

///|
test "archive inspection refuses absent README license and native assets" {
  let manifest = fixture_manifest("pkgs/core", "finos/morphir-core")
  for missing in ["README.md", "LICENSE", "native.c"] {
    let files = fixture_archive_files().filter(entry => entry.0 != missing)
    let problem = try {
      ignore(inspect_archive(manifest, fixture_archive(files)))
      None
    } catch {
      Refusal(problem) => Some(problem)
      error => raise error
    }
    assert_true(problem is Some(ArchiveInvalid(_)))
  }
  let files = fixture_archive_files()
  files.push(("node_modules/dependency/index.js", b"unrelated build payload"))
  let problem = try {
    ignore(inspect_archive(manifest, fixture_archive(files)))
    None
  } catch {
    Refusal(problem) => Some(problem)
    error => raise error
  }
  assert_true(problem is Some(ArchiveInvalid(_)))
}

///|
test "compiler concurrency spelling retains strict package and native asset checks" {
  let manifest = fixture_manifest("pkgs/core", "finos/morphir-core")
  let config = "max_concurrent_tests = 1\noptions(\"native-stub\": [\"native.c\"])\n"
  let files = fixture_archive_files().map(entry => {
    if entry.0 == "moon.pkg" {
      (entry.0, @utf8.encode(config))
    } else {
      entry
    }
  })
  ignore(inspect_archive(manifest, fixture_archive(files)))
  let missing = files.filter(entry => entry.0 != "native.c")
  let refused = try {
    ignore(inspect_archive(manifest, fixture_archive(missing)))
    false
  } catch {
    Refusal(ArchiveInvalid(message)) =>
      message == "Missing native stub: native.c"
    error => raise error
  }
  assert_true(refused)
  for
    invalid in [
      "max_concurrent_tests = \"1\"", "max_concurrent_tests = 0", "max_concurrent_tests = -1",
      "max_concurrent_tests = 1.5", "max_concurrent_tests = 2147483648", "max_concurrent_tests = 1\nmax_concurrent_tests = 2",
      "max_concurrent_tests = 1\noptions(\"max-concurrent-tests\": 2)", "max_concurrent_tests = 1\nunknown_option = true",
      "max_concurrent_tests = 1\noptions(", "max_concurrent_tests = 1\noptions(\"native-stub\": 42)",
    ] {
    let files = fixture_archive_files().map(entry => {
      if entry.0 == "moon.pkg" {
        (entry.0, @utf8.encode(invalid))
      } else {
        entry
      }
    })
    let refused = try {
      ignore(inspect_archive(manifest, fixture_archive(files)))
      false
    } catch {
      Refusal(ArchiveInvalid(_)) => true
      error => raise error
    }
    assert_true(refused, msg=invalid)
  }
}
