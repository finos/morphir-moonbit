#!/usr/bin/env bash
# mise description="Store superpowers specs, plans and ledgers in beads, and render them back (bd-plan from finos/morphir)"
# Pass the command after --, for example: mise run beads:plan -- render <plan-epic>
#
# bd-plan lives in finos/morphir (tools/bd-plan.ts) and imports only node:
# builtins, so this task fetches it at a pinned commit and runs it with Bun.
# Bump BD_PLAN_COMMIT to pick up a newer bd-plan.
set -euo pipefail

BD_PLAN_COMMIT="d6b7cfa4cd614c85a087c009505c2856d5c73086"
cache_dir="${XDG_CACHE_HOME:-$HOME/.cache}/morphir/bd-plan/${BD_PLAN_COMMIT}"
script="${cache_dir}/bd-plan.ts"

if [ ! -f "$script" ]; then
  mkdir -p "$cache_dir"
  curl -fsSL "https://raw.githubusercontent.com/finos/morphir/${BD_PLAN_COMMIT}/tools/bd-plan.ts" -o "${script}.tmp"
  mv "${script}.tmp" "$script"
fi

exec bun run "$script" "$@"
