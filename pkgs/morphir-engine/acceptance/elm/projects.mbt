    {
      name: "signatures",
      package_name: "Parity.Signatures",
      exposed: ["Functions", "Constrained"],
      sources: [
        (
          "Parity/Signatures/Constrained.elm",
          (
            #|module Parity.Signatures.Constrained exposing (double, larger, join, sorted, pairs)
            #|
            #|
            #|double : number -> number
            #|double n =
            #|    n + n
            #|
            #|
            #|larger : comparable -> comparable -> comparable
            #|larger a b =
            #|    if a > b then
            #|        a
            #|
            #|    else
            #|        b
            #|
            #|
            #|join : appendable -> appendable -> appendable
            #|join a b =
            #|    a ++ b
            #|
            #|
            #|sorted : List comparable -> List comparable
            #|sorted items =
            #|    List.sort items
            #|
            #|
            #|pairs : List a -> List ( a, Bool )
            #|pairs items =
            #|    let
            #|        mark item =
            #|            ( item, True )
            #|    in
            #|    List.map mark items
            #|
          ),
        ),
        (
          "Parity/Signatures/Functions.elm",
          (
            #|module Parity.Signatures.Functions exposing (..)
            #|
            #|
            #|constant : Int
            #|constant =
            #|    1
            #|
            #|
            #|add : Int -> Int -> Int
            #|add a b =
            #|    a + b
            #|
            #|
            #|swap : ( a, b ) -> ( b, a )
            #|swap ( a, b ) =
            #|    ( b, a )
            #|
            #|
            #|ignore : a -> Int
            #|ignore _ =
            #|    0
            #|
            #|
            #|unit : () -> Int
            #|unit () =
            #|    0
            #|
            #|
            #|leading : Int -> Int -> Int
            #|leading =
            #|    \a b -> a + b
            #|
            #|
            #|partial : Int -> Int -> Int
            #|partial a =
            #|    \b -> a + b
            #|
            #|
            #|paren : a -> b -> a
            #|paren a =
            #|    (\x -> a)
            #|
            #|
            #|tupleLambda : Int -> ( Int, Int ) -> Int
            #|tupleLambda =
            #|    \a ( b, c ) -> a + b + c
            #|
            #|
            #|mixed : Int -> ( Int, Int ) -> Int -> Int
            #|mixed a ( b, c ) d =
            #|    a + b + c + d
            #|
            #|
            #|increment : Int -> Int
            #|increment =
            #|    add 1
            #|
            #|
            #|type alias Handler =
            #|    Int -> Int
            #|
            #|
            #|handler : Handler
            #|handler x =
            #|    x
            #|
            #|
            #|lambdaHandler : Handler
            #|lambdaHandler =
            #|    \y -> y
            #|
            #|
            #|curried : Int -> Handler
            #|curried a b =
            #|    a
            #|
            #|
            #|parenHandler : ( Handler )
            #|parenHandler x =
            #|    x
            #|
            #|
            #|parenFunction : (Int -> Int)
            #|parenFunction x =
            #|    x
            #|
          ),
        ),
      ],
