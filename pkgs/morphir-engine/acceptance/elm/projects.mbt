    {
      name: "lets",
      package_name: "Parity.Lets",
      exposed: ["Blocks"],
      sources: [
        (
          "Parity/Lets/Blocks.elm",
          (
            #|module Parity.Lets.Blocks exposing (inOrder, reordered, chain, function, annotated, destructure, selfRecursive, mutual, scaled)
            #|
            #|{-| Let blocks: dependency order, let functions, destructuring and recursion. -}
            #|
            #|
            #|inOrder : Int
            #|inOrder =
            #|    let a = 1
            #|        b = 2
            #|    in a
            #|
            #|reordered : Int
            #|reordered =
            #|    let a = b
            #|        b = 1
            #|        c = 2
            #|    in c
            #|
            #|chain : Int
            #|chain =
            #|    let x = 1
            #|        y = z
            #|        z = x
            #|    in y
            #|
            #|function : Int
            #|function =
            #|    let f x = x
            #|    in f 1
            #|
            #|annotated : Int
            #|annotated =
            #|    let g : Int -> Int
            #|        g x = x
            #|    in g 1
            #|
            #|destructure : ( Int, Int ) -> Int
            #|destructure t =
            #|    let ( a, b ) = t
            #|    in a
            #|
            #|selfRecursive : Int
            #|selfRecursive =
            #|    let loop n = loop n
            #|    in loop 1
            #|
            #|mutual : Int
            #|mutual =
            #|    let p = q 1
            #|        q k = r k
            #|        r k = q k
            #|        s = p
            #|    in s
            #|
            #|scaled : Float -> Float
            #|scaled price =
            #|    let rate = 2
            #|    in price * rate
            #|
          ),
        ),
      ],
    },
    {
      name: "modules",
      package_name: "Parity.Modules",
      exposed: ["Api"],
      sources: [
        (
          "Parity/Modules/Api.elm",
          (
            #|module Parity.Modules.Api exposing (Request, isBlank, lookup, start)
            #|
            #|{-| The exposed module.
            #|
            #|It imports Util with an alias and an exposing list.
            #|-}
            #|
            #|import Parity.Modules.Sig as Sig
            #|import Parity.Modules.Tag exposing (Tag(..))
            #|import Parity.Modules.Unused
            #|import Parity.Modules.Util as U exposing (Id, one)
            #|
            #|
            #|{-| A request. -}
            #|type alias Request =
            #|    { id : Id, count : Int }
            #|
            #|
            #|start : Request
            #|start =
            #|    { id = U.empty, count = one }
            #|
            #|
            #|lookup : Id -> Request -> Maybe Int
            #|lookup id request =
            #|    if id == request.id then
            #|        Just request.count
            #|
            #|    else
            #|        Nothing
            #|
            #|
            #|isBlank : Sig.Code -> Bool
            #|isBlank code =
            #|    code == ""
            #|
            #|
            #|tagged : Tag
            #|tagged =
            #|    Tag 1
            #|
          ),
        ),
        (
          "Parity/Modules/Base.elm",
          (
            #|module Parity.Modules.Base exposing (base)
            #|
