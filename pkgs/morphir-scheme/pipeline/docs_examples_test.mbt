///|
priv enum Expect {
  Value(String)
  Fails(String)
  Runs
}

///|
/// Run one example with this package's `run_example` and compare the result with what the chapter states.
fn check_example(
  files : Array[(String, String)],
  expect : Expect,
  line~ : Int32,
) -> Unit raise {
  let result : Result[String, String] = Ok(run_example(files)) catch {
    e => Err(@scheme.error_message(e))
  }
  match (expect, result) {
    (Value(want), Ok(got)) =>
      if got != want {
        fail("line \{line}: expected \{want}, got \{got}")
      }
    (Runs, Ok(_)) => ()
    (Fails(prefix), Err(message)) =>
      if !message.has_prefix(prefix) {
        fail(
          "line \{line}: expected an error starting with \{prefix}, got \{message}",
        )
      }
    (Fails(prefix), Ok(got)) =>
      fail(
        "line \{line}: expected an error starting with \{prefix}, got \{got}",
      )
    (_, Err(message)) => fail("line \{line}: unexpected error: \{message}")
  }
}

