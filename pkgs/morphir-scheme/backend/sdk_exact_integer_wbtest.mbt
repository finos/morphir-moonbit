// Generated by pkgs/morphir-sdk/conformance/generate_exact_integer_extension.py.
// Mathematical extension beyond Elm JavaScript safe integers.

///|
test "exact integer extension beyond Elm safe range" {
  let runtime = @scheme.Runtime::new()
  install(runtime)
  let cases : Array[(String, String, String)] = [
    (
      "morphir/SDK:basics#add", "(%morphir-sdk \"morphir/SDK:basics#add\" 9007199254740993 2)",
      "9007199254740995",
    ),
    (
      "morphir/SDK:basics#multiply", "(%morphir-sdk \"morphir/SDK:basics#multiply\" 4294967297 4294967297)",
      "18446744082299486209",
    ),
    (
      "morphir/SDK:basics#power", "(%morphir-sdk \"morphir/SDK:basics#power\" 2 100)",
      "1267650600228229401496703205376",
    ),
    (
      "morphir/SDK:basics#integer-divide", "(%morphir-sdk \"morphir/SDK:basics#integer-divide\" -9007199254740993 3)",
      "-3002399751580331",
    ),
    (
      "morphir/SDK:basics#remainder-by", "(%morphir-sdk \"morphir/SDK:basics#remainder-by\" 7 -9007199254740993)",
      "-5",
    ),
    (
      "morphir/SDK:basics#mod-by", "(%morphir-sdk \"morphir/SDK:basics#mod-by\" 7 -9007199254740993)",
      "2",
    ),
    (
      "morphir/SDK:string#from-int", "(%morphir-sdk \"morphir/SDK:string#from-int\" 9007199254740993)",
      "\"9007199254740993\"",
    ),
    (
      "morphir/SDK:string#to-int", "(%morphir-sdk \"morphir/SDK:string#to-int\" \"9007199254740993\")",
      "Just 9007199254740993",
    ),
    (
      "morphir/SDK:list#range", "(%morphir-sdk \"morphir/SDK:list#range\" 9007199254740993 9007199254740995)",
      "[9007199254740993,9007199254740994,9007199254740995]",
    ),
    (
      "morphir/SDK:decimal#from-int", "(%morphir-sdk \"morphir/SDK:decimal#from-int\" 9007199254740993)",
      "\"9007199254740993\"",
    ),
    (
      "morphir/SDK:int#to-int64", "(%morphir-sdk \"morphir/SDK:int#to-int64\" -9223372036854775808)",
      "Just -9223372036854775808",
    ),
    (
      "morphir/SDK:int#to-int64", "(%morphir-sdk \"morphir/SDK:int#to-int64\" 9223372036854775807)",
      "Just 9223372036854775807",
    ),
    (
      "morphir/SDK:int#to-int64", "(%morphir-sdk \"morphir/SDK:int#to-int64\" 9223372036854775808)",
      "Nothing",
    ),
    (
      "morphir/SDK:int#from-int64", "(%morphir-sdk \"morphir/SDK:int#from-int64\" (%morphir-tag \"morphir/SDK:int#int64\" -9223372036854775808))",
      "-9223372036854775808",
    ),
  ]
  assert_eq(cases.length(), 14)
  for (name, source, expected) in cases {
    let actual = oracle_render(runtime.eval(source), 0)
    if actual != expected {
      abort(name + " expected " + expected + ", got " + actual)
    }
  }
}
