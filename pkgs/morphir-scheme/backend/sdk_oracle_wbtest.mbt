  assert_eq(cases.length(), 310)
  for (name, source, expected) in cases {
    let actual = oracle_render(runtime.eval(source), 0) catch {
      _ => abort(name + " failed")
    }
    if actual != expected {
      abort(name + " expected " + expected + ", got " + actual)
    }
  }
}
