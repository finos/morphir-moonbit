            #|    z + a + b + w
            #|
            #|partial : Int -> Int -> Int
            #|partial a =
            #|    \b -> a + b
            #|
            #|paren : Int -> Int -> Int
            #|paren a =
            #|    (\x -> a)
            #|
            #|prefix : Int -> Int -> Int
            #|prefix =
            #|    (+)
            #|
            #|handler : Handler
            #|handler =
            #|    \n -> n * 2
            #|
            #|mapped : List Int -> List Int
            #|mapped l =
            #|    List.map (\v -> v + 1) l
            #|
          ),
        ),
