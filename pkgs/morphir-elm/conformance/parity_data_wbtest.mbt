            #|    Circle r -> r * r
            #|    Rect w h -> w * h
            #|    Empty -> 0
            #|
            #|ints : Int -> Int
            #|ints n = case n of
            #|    0 -> 1
            #|    0x10 -> 2
            #|    _ -> n
            #|
            #|textual : Char -> String -> Int
