///|
fn literal(text : String) -> String {
  "\"" +
  text
  .replace_all(old="\\", new="\\\\")
  .replace_all(old="\"", new="\\\"")
  .replace_all(old="\n", new="\\n") +
  "\""
}

///|
fn expect_source(expect : Expect) -> String {
  match expect {
    Value(v) => "Value(\{literal(v)})"
    Fails(m) => "Fails(\{literal(m)})"
    Runs => "Runs"
  }
}

///|
let harness : String =
  #|
  #|///|
  #|priv enum Expect {
  #|  Value(String)
  #|  Fails(String)
  #|  Runs
  #|}
  #|
  #|///|
  #|/// Run one example with this package's `run_example` and compare the result with what the chapter states.
  #|fn check_example(
  #|  files : Array[(String, String)],
  #|  expect : Expect,
  #|  line~ : Int32,
  #|) -> Unit raise {
  #|  let result : Result[String, String] = Ok(run_example(files)) catch {
  #|    e => Err(@scheme.error_message(e))
  #|  }
  #|  match (expect, result) {
  #|    (Value(want), Ok(got)) =>
  #|      if got != want {
  #|        fail("line \{line}: expected \{want}, got \{got}")
  #|      }
  #|    (Runs, Ok(_)) => ()
  #|    (Fails(prefix), Err(message)) =>
  #|      if !message.has_prefix(prefix) {
  #|        fail(
  #|          "line \{line}: expected an error starting with \{prefix}, got \{message}",
  #|        )
  #|      }
  #|    (Fails(prefix), Ok(got)) =>
  #|      fail(
  #|        "line \{line}: expected an error starting with \{prefix}, got \{got}",
  #|      )
  #|    (_, Err(message)) => fail("line \{line}: unexpected error: \{message}")
  #|  }
  #|}

///|
pub fn render_examples(chapter_name : String, chapter : Chapter) -> String {
  let out = StringBuilder()
  out.write_string(
    "// GENERATED by `mise run scheme-docs:generate` from \{chapter_name}. Do not edit.\n",
  )
  out.write_string(
    "// \{chapter.examples.length()} checked examples; \{chapter.skipped} notest blocks.\n",
  )
  out.write_string(harness)
  out.write_string("\n")
  for n, example in chapter.examples {
    out.write_string(
      "\n///|\ntest \"\{chapter_name} example \{n + 1} (line \{example.line})\" {\n  check_example(\n    [\n",
    )
    for file in example.files {
      out.write_string("      (\n        \{literal(file.0)},\n        (\n")
      for source_line in file.1.split("\n") {
        out.write_string("          #|\{source_line}\n")
      }
      out.write_string("        ),\n      ),\n")
    }
    out.write_string(
      "    ],\n    \{expect_source(example.expect)},\n    line=\{example.line},\n  )\n}\n",
    )
  }
  out.to_string()
}

///|
pub fn render_procedures(chapter_name : String, chapter : Chapter) -> String? {
  if chapter.procedures.is_empty() {
    return None
  }
  let names = chapter.procedures.map(literal).join(", ")
  Some(
    "// GENERATED by `mise run scheme-docs:generate` from \{chapter_name}. Do not edit.\n\n///|\nlet documented_procedures : Array[String] = [\{names}]\n",
  )
}

///|
fn split_lines(text : String) -> Array[String] {
  let result : Array[String] = []
  for l in text.replace_all(old="\r", new="").split("\n") {
    result.push(l.to_owned())
  }
  result
}

///|
/// How line `i` of `lines` reads in a message. The empty piece after the final newline is the end of the file.
fn describe_line(lines : Array[String], i : Int32) -> String {
  if i >= lines.length() || (i == lines.length() - 1 && lines[i] == "") {
    "end of file"
  } else {
    "`\{lines[i]}`"
  }
}

///|
/// The first line, counted from 1, where the texts differ, and how they differ there.
fn first_difference(expected : String, actual : String) -> (Int32, String)? {
  let a = split_lines(expected)
  let b = split_lines(actual)
  let n = if a.length() > b.length() { a.length() } else { b.length() }
  for i in 0..<n {
    let same = i < a.length() && i < b.length() && a[i] == b[i]
    if !same {
      return Some(
        (i + 1, "expected \{describe_line(a, i)}, found \{describe_line(b, i)}"),
      )
    }
  }
  None
}

///|
pub fn difference(expected : String, actual : String) -> String? {
  match first_difference(expected, actual) {
    Some((line, detail)) => Some("line \{line}: \{detail}")
    None => None
  }
}

///|
/// The chapter number and the chapter line of the example whose generated test starts at or above `line`
/// (counted from 1) of the generated text, read from its `test "<chapter> example K (line L)"` header.
fn example_at(
  chapter_name : String,
  generated : Array[String],
  line : Int32,
) -> (String, String)? {
  let prefix = "test \"\{chapter_name} example "
  let mut i = line - 1
  if i >= generated.length() {
    i = generated.length() - 1
  }
  while i >= 0 {
    let text = generated[i]
    if text.has_prefix(prefix) {
      let rest = text[prefix.length():].to_owned()
      guard rest.find(" (line ") is Some(k_end) else { return None }
      let number = rest[:k_end].to_owned()
      let after = rest[k_end + 7:].to_owned()
      guard after.find(")") is Some(l_end) else { return None }
      return Some((number, after[:l_end].to_owned()))
    }
    i -= 1
  }
  None
}

///|
/// The message `check` prints for a generated file that differs from what the chapter generates.
/// It names the chapter and, inside an example, the chapter line and number of that example, then the generated
/// file and its line. A difference in the file header or the harness names the chapter only.
pub fn check_message(
  chapter_name : String,
  file : String,
  expected : String,
  actual : String,
) -> String? {
  guard first_difference(expected, actual) is Some((line, detail)) else {
    return None
  }
  let place = match example_at(chapter_name, split_lines(expected), line) {
    Some((number, chapter_line)) =>
      "\{chapter_name} line \{chapter_line} (example \{number})"
    None => chapter_name
  }
  Some("\{place}: \{file} line \{line}: \{detail}")
}
