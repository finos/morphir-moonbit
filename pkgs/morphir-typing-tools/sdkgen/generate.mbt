///|
/// The text of `sdk_data.mbt` for the specification in `sdk.scm`.
fn generated_text(scm : String) -> String raise Error {
  let (package_name, specification) = @spec.read_package(scm)
  let file = @ir.IRFile::new(
    @ir.Distribution::Specs(package_name, Map([]), specification),
  )
  let json = @ir_json.to_json(file) catch {
    @wire.Invalid(c, d) => raise ToolError("to_json " + c + ": " + d)
    e => raise e
  }
  let lines = json.stringify(indent=1).split("\n").collect()
  let body = StringBuilder()
  body.write_string(
    "// GENERATED by `mise run sdk-spec:generate` from sdk.scm. Do not edit.\n\n///|\nlet sdk_json : String =\n",
  )
  for i, line in lines {
    if i > 0 {
      body.write_string("\n")
    }
    body.write_string("  #|\{line}")
  }
  body.write_string("\n")
  body.to_string()
}

///|
fn generate() -> String raise Error {
  let text = generated_text(@fs.read_file_to_string(scm_path))
  @fs.write_string_to_file(data_path, text)
  "wrote \{data_path}"
}
